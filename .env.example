# GoShipping Environment Configuration
NODE_ENV=development
PORT=4321
HOST=0.0.0.0
APP_URL=http://localhost:4321

# Hostinger MySQL / MariaDB Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=goshipping
DB_CONNECTION_LIMIT=10

# Security & Session Secrets
SESSION_SECRET=goshipping_super_secret_session_key_min_32_characters_random
JWT_SECRET=goshipping_jwt_secret_token_secure_string_2026

# Tracking & Polling Configurations
TRACKING_POLL_INTERVAL_MS=25000
BACKGROUND_POLL_PAUSE=true

# Dynamic Domain & Social Tracking Configuration
# The system automatically infers active domain from incoming request Host/Proto headers.
# You can optionally set PUBLIC_SITE_URL or APP_URL as a fallback.
PUBLIC_SITE_URL=https://www.goshipping.com.bd

# Google Tag Manager (GTM) Container ID (e.g. GTM-XXXXXXX)
PUBLIC_GTM_ID=

# Meta / Facebook Pixel ID (e.g. 123456789012345)
PUBLIC_FB_PIXEL_ID=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=

# TikTok Pixel ID (e.g. CXXXXXXXXXXXXX)
PUBLIC_TIKTOK_PIXEL_ID=

# LinkedIn Insight Tag Partner ID (e.g. 1234567)
PUBLIC_LINKEDIN_PARTNER_ID=

# Twitter / X Pixel ID
PUBLIC_TWITTER_PIXEL_ID=

# Pinterest Tag ID
PUBLIC_PINTEREST_TAG_ID=

# Resend API Configuration (Branded Domain Delivery)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM_NAME="GoShipping Express"
EMAIL_FROM_ADDRESS=notifications@support.goshipping.com.bd
EMAIL_OPS_ADDRESS=ops@goshipping.com.bd

# Optional SMTP Mailer Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@goshipping.com
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM="GoShipping Logistics" <support@goshipping.com>
