# GoShipping Environment Configuration
NODE_ENV=development
PORT=4321
HOST=0.0.0.0
APP_URL=http://localhost:4321

# Hostinger MySQL / MariaDB Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=goshipping
DB_CONNECTION_LIMIT=10

# Security & Session Secrets
SESSION_SECRET=goshipping_super_secret_session_key_min_32_characters_random
JWT_SECRET=goshipping_jwt_secret_token_secure_string_2026

# Tracking & Polling Configurations
TRACKING_POLL_INTERVAL_MS=25000
BACKGROUND_POLL_PAUSE=true

# Optional SMTP Mailer Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@goshipping.com
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM="GoShipping Logistics" <support@goshipping.com>
