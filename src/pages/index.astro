---
import PublicLayout from '../layouts/PublicLayout.astro';
import LiveTrackingIsland from '../components/marketing/LiveTrackingIsland';
import QuoteCalculatorIsland from '../components/marketing/QuoteCalculatorIsland';
import { IndustrialScrollShowcase } from '../components/marketing/IndustrialScrollShowcase';
---

<PublicLayout
  title="Go Shipping | China to Bangladesh Shipping & Logistics"
  description="Reliable Air & Sea Shipment Solutions with Door-to-Door Delivery for businesses and online sellers across Bangladesh."
  keywords="China to Bangladesh shipping, China to Bangladesh logistics, China to Bangladesh air shipment, China to Bangladesh sea shipment, door-to-door delivery Bangladesh, China cargo forwarding, Guangzhou to Dhaka freight, Shenzhen to Chittagong shipping, customs clearance Bangladesh, DDP shipping Bangladesh, China warehouse support, e-commerce shipping Bangladesh, Go Shipping, goshipping.com.bd"
  currentPath="/"
  image="/og/og-home.png"
>
  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION: China-to-Bangladesh Logistics Editorial                  -->
  <!-- ========================================================================= -->
  <section class="relative bg-white pt-10 pb-16 lg:pt-16 lg:pb-24 border-b border-slate-200 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Route Badge & Status Indicator */}
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-slate-100 border border-slate-200 mb-6">
        <span class="w-2 h-2 rounded-full bg-[#EA1D2C] motion-safe:animate-pulse motion-reduce:animate-none"></span>
        <span class="text-xs font-bold text-slate-800 tracking-tight">
          Trusted China → Bangladesh Logistics
        </span>
      </div>

      {/* Two-Column Editorial Hero Grid */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-10 lg:mb-14">
        
        {/* Left: Large Editorial Headline */}
        <div class="lg:col-span-7">
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-[#11181E] tracking-tight leading-[1.04]">
            China to Bangladesh &amp; Malaysia,<br />
            <span class="text-[#EA1D2C]">Delivered with Confidence.</span>
          </h1>
        </div>

        {/* Right: Route Context & Actions */}
        <div class="lg:col-span-5 lg:pl-4 space-y-6">
          <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
            Reliable Air &amp; Sea Cargo Solutions with Door-to-Door Delivery connecting China directly to Bangladesh and Malaysia.
          </p>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="/quote"
              class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-[#11181E] text-white text-xs font-bold hover:bg-slate-800 active:bg-slate-900 transition-colors duration-150 border border-[#11181E]"
            >
              Ship for Me
            </a>
            <a
              href="/tracking"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-md border border-slate-300 bg-white text-slate-900 text-xs font-bold hover:bg-slate-50 active:bg-slate-100 transition-colors duration-150 shadow-xs"
            >
              <svg class="w-3.5 h-3.5 text-[#EA1D2C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Track Shipment</span>
            </a>
          </div>

          {/* Authentic Transit Route Details & Trust Signals */}
          <div class="pt-3 border-t border-slate-200 space-y-2">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-bold text-slate-800">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#EA1D2C]"></span>
                Safe Cargo
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#EA1D2C]"></span>
                Reliable Delivery
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[#EA1D2C]"></span>
                Dedicated Support
              </span>
            </div>
            <div class="flex flex-wrap gap-x-6 gap-y-1 text-xs text-slate-500">
              <div>
                <span class="font-bold text-slate-900">Air Shipment:</span> 7–14 Days
              </div>
              <div>
                <span class="font-bold text-slate-900">Sea Shipment:</span> 35–45 Days
              </div>
            </div>
            <p class="text-[11px] text-slate-400 italic">
              Delivery times are approximate service estimates and are not guaranteed.
            </p>
          </div>
        </div>
      </div>

      {/* Hero Visual Composition: Architectural Shipping Container & Live Tracking Bar */}
      <div class="relative rounded-xl overflow-hidden bg-[#11181E] border border-slate-300">
        <div class="relative aspect-[16/9] sm:aspect-[21/9] w-full overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&w=2200&q=85"
            alt="GoShipping Stacked Intermodal Shipping Containers"
            class="w-full h-full object-cover object-center filter contrast-105"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/30 to-black/60"></div>

          {/* Industrial Stencil Markings */}
          <div class="absolute top-6 left-6 sm:top-10 sm:left-12 space-y-1 text-white/90">
            <span class="text-xs text-slate-300 block">
              Corridor Hub No. GZ-BD-2026-081
            </span>
            <div class="text-3xl sm:text-5xl font-black tracking-tight text-white">
              GoShipping Freight
            </div>
            <span class="text-xs text-slate-300 block">
              Guangzhou CFS, Shenzhen Port, Dhaka HSIA, Chittagong Port
            </span>
          </div>

          {/* Technical Specs Overlay */}
          <div class="absolute bottom-6 left-6 sm:bottom-10 sm:left-12 text-white/90 text-xs flex items-center gap-3">
            <div class="border border-white/60 bg-black/60 rounded px-2.5 py-1 text-[11px] font-bold">
              MAX GROSS 32,500 KG
            </div>
            <span class="hidden md:inline text-white/70">
              China Warehouse Support · Customs Clearance · Door-to-Door
            </span>
          </div>

          {/* Prominent Hero Fast-Track Input Card */}
          <div class="absolute bottom-6 right-6 sm:bottom-10 sm:right-10 max-w-sm w-full hidden sm:block">
            <div class="p-4 sm:p-5 rounded-lg bg-white border border-slate-200 space-y-2.5 shadow-lg">
              <div class="flex items-center justify-between text-xs font-bold text-slate-900">
                <span class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-[#EA1D2C] animate-pulse"></span>
                  <span>Track Your Shipment</span>
                </span>
                <a href="/tracking" class="text-[#EA1D2C] text-[11px] font-semibold hover:underline flex items-center gap-0.5">
                  <span>Open Portal</span>
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
              <form action="/tracking" method="GET" class="flex gap-2">
                <input
                  type="text"
                  name="code"
                  placeholder="Tracking Code, Email, or Phone..."
                  class="flex-1 h-10 px-3.5 rounded-md border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-[#EA1D2C]"
                  required
                />
                <button
                  type="submit"
                  class="h-10 px-4 rounded-md bg-[#EA1D2C] text-white font-bold text-xs hover:bg-[#D01422] active:bg-[#B7101C] transition-colors duration-150 cursor-pointer shrink-0"
                >
                  Track
                </button>
              </form>
              <div class="flex items-center justify-between text-[11px] text-slate-500 pt-0.5">
                <span>Search by Tracking Code, Email, or Phone</span>
                <a href="/tracking" class="text-slate-700 font-semibold hover:text-[#EA1D2C] transition-colors inline-flex items-center gap-1">
                  <span>Tracking Page</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* 4 Core Value Highlights from GoShipping */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
        <div class="p-5 rounded-lg bg-slate-50 border border-slate-200">
          <span class="text-xs font-black text-[#EA1D2C] font-mono">01</span>
          <h3 class="text-sm font-extrabold text-slate-900 mt-1">Safe & Secure</h3>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">Your cargo is handled with care from warehouse to delivery.</p>
        </div>
        <div class="p-5 rounded-lg bg-slate-50 border border-slate-200">
          <span class="text-xs font-black text-[#EA1D2C] font-mono">02</span>
          <h3 class="text-sm font-extrabold text-slate-900 mt-1">Door-to-Door</h3>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">Complete shipping support from China to Bangladesh.</p>
        </div>
        <div class="p-5 rounded-lg bg-slate-50 border border-slate-200">
          <span class="text-xs font-black text-[#EA1D2C] font-mono">03</span>
          <h3 class="text-sm font-extrabold text-slate-900 mt-1">Fast Air Shipment</h3>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">Reliable air freight for time-sensitive shipments.</p>
        </div>
        <div class="p-5 rounded-lg bg-slate-50 border border-slate-200">
          <span class="text-xs font-black text-[#EA1D2C] font-mono">04</span>
          <h3 class="text-sm font-extrabold text-slate-900 mt-1">Sea Shipment</h3>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">Cost-effective sea freight for larger shipments.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. SIGNATURE PINNED LOGISTICS SHOWCASE (Machinery & Highway Animation)    -->
  <!-- ========================================================================= -->
  <IndustrialScrollShowcase client:visible />

  <!-- ========================================================================= -->
  <!-- 3. HOW IT WORKS: Shipping Made Simple                                     -->
  <!-- ========================================================================= -->
  <section id="how-it-works" class="py-20 lg:py-28 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Category Heading */}
      <span class="text-xs font-bold text-[#EA1D2C] uppercase tracking-wider block mb-3 font-mono">
        /HOW IT WORKS
      </span>

      {/* Two-Column Process Header */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
        <div class="lg:col-span-7">
          <h2 class="text-3xl sm:text-5xl font-extrabold text-[#11181E] tracking-tight leading-[1.08]">
            Shipping Made Simple.<br />
            <span class="text-slate-400 font-medium">Three clear steps from China to your doorstep.</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pl-6">
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
            No intermediaries and no blind spots. We manage the entire logistics journey from warehouse receiving in China to verified delivery across Bangladesh.
          </p>
        </div>
      </div>

      {/* 3 Authentic Process Cards */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {/* Step 1 */}
        <div class="p-8 rounded-lg bg-slate-50 border border-slate-200 flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <span class="text-3xl font-black text-[#EA1D2C] font-mono">01</span>
            <h3 class="text-xl font-extrabold text-slate-900">
              Send Your Product Details
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Share your product and shipment information with our team.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-200 text-xs text-slate-500 font-mono">
            China Warehouse Receiving Support
          </div>
        </div>

        {/* Step 2 */}
        <div class="p-8 rounded-lg bg-slate-50 border border-slate-200 flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <span class="text-3xl font-black text-[#EA1D2C] font-mono">02</span>
            <h3 class="text-xl font-extrabold text-slate-900">
              Get Your Shipping Quote
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              We calculate the shipping cost and provide the available options.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-200 text-xs text-slate-500 font-mono">
            Transparent Air & Sea Freight Rates
          </div>
        </div>

        {/* Step 3 */}
        <div class="p-8 rounded-lg bg-slate-50 border border-slate-200 flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <span class="text-3xl font-black text-[#EA1D2C] font-mono">03</span>
            <h3 class="text-xl font-extrabold text-slate-900">
              Receive Your Shipment
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              We handle the logistics and deliver your cargo to Bangladesh.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-200 text-xs text-slate-500 font-mono">
            Door-to-Door Delivery Across 64 Districts
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- ABOUT GO SHIPPING & SHIPPING METHOD SELECTION                             -->
  <!-- ========================================================================= -->
  <section id="about" class="py-20 lg:py-28 bg-[#F8FAFC] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        {/* Left Column: About Go Shipping */}
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-bold text-[#EA1D2C] uppercase tracking-wider block font-mono">
            China → BD End-to-end support
          </span>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-[#11181E] tracking-tight leading-[1.08]">
            About Go Shipping<br />
            <span class="text-slate-400 font-medium">Your Trusted China to Bangladesh Shipping Partner</span>
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
            We help online sellers, e-commerce businesses and importers move products from China to Bangladesh with reliable shipping and door-to-door logistics support.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs font-bold text-slate-800">
            <div class="flex items-center gap-2.5 p-3 rounded-md bg-white border border-slate-200">
              <span class="w-2 h-2 rounded-full bg-[#EA1D2C]"></span>
              China Warehouse Support
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-md bg-white border border-slate-200">
              <span class="w-2 h-2 rounded-full bg-[#EA1D2C]"></span>
              Safe & Secure Cargo Handling
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-md bg-white border border-slate-200">
              <span class="w-2 h-2 rounded-full bg-[#EA1D2C]"></span>
              Door-to-Door Delivery
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-md bg-white border border-slate-200">
              <span class="w-2 h-2 rounded-full bg-[#EA1D2C]"></span>
              Customs Clearance Support
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-md bg-white border border-slate-200 sm:col-span-2">
              <span class="w-2 h-2 rounded-full bg-[#EA1D2C]"></span>
              Small & Large Shipment Accepted
            </div>
          </div>
          <div class="pt-2">
            <a
              href="/services"
              class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-[#11181E] text-white text-xs font-bold hover:bg-slate-800 transition-colors duration-150 border border-[#11181E]"
            >
              Learn More
            </a>
          </div>
        </div>

        {/* Right Column: Air or Sea Comparison Card */}
        <div class="lg:col-span-6">
          <div class="p-8 sm:p-10 rounded-lg bg-white border border-slate-200 space-y-6">
            <div>
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block font-mono">
                /BY AIR, BY SHIP &amp; HAND CARRY
              </span>
              <h3 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-1">
                Choose the Right Shipping Method
              </h3>
              <p class="text-xs text-slate-500 italic mt-1">
                Delivery times are approximate service estimates and are not guaranteed.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              {/* By Air */}
              <div class="p-5 rounded-md bg-slate-50 border border-slate-200 space-y-2.5">
                <span class="text-[11px] font-bold text-[#EA1D2C] uppercase tracking-wider block font-mono">
                  Approx. transit
                </span>
                <div class="text-base font-black text-slate-900">By Air</div>
                <div class="text-2xl font-black text-[#EA1D2C] font-mono">7–14 Days</div>
                <div class="pt-3 border-t border-slate-200 text-xs text-slate-600 space-y-1.5">
                  <div class="font-bold text-slate-900">Best for:</div>
                  <div class="flex items-center gap-1.5"><span class="text-[#EA1D2C]">•</span> Urgent commercial cargo</div>
                  <div class="flex items-center gap-1.5"><span class="text-[#EA1D2C]">•</span> Small &amp; medium packages</div>
                  <div class="flex items-center gap-1.5"><span class="text-[#EA1D2C]">•</span> Time-sensitive apparel &amp; tech</div>
                </div>
              </div>

              {/* By Ship */}
              <div class="p-5 rounded-md bg-slate-50 border border-slate-200 space-y-2.5">
                <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block font-mono">
                  Approx. transit
                </span>
                <div class="text-base font-black text-slate-900">By Ship</div>
                <div class="text-2xl font-black text-slate-900 font-mono">35–45 Days</div>
                <div class="pt-3 border-t border-slate-200 text-xs text-slate-600 space-y-1.5">
                  <div class="font-bold text-slate-900">Best for:</div>
                  <div class="flex items-center gap-1.5"><span class="text-slate-400">•</span> Large bulk shipments</div>
                  <div class="flex items-center gap-1.5"><span class="text-slate-400">•</span> Heavy machinery &amp; FCL/LCL</div>
                  <div class="flex items-center gap-1.5"><span class="text-slate-400">•</span> Cost-conscious imports</div>
                </div>
              </div>

              {/* Hand Carry */}
              <div class="p-5 rounded-md bg-slate-50 border border-slate-200 space-y-2.5">
                <span class="text-[11px] font-bold text-amber-600 uppercase tracking-wider block font-mono">
                  Approx. transit
                </span>
                <div class="text-base font-black text-slate-900">Hand Carry</div>
                <div class="text-2xl font-black text-amber-600 font-mono">24–48 Hours</div>
                <div class="pt-3 border-t border-slate-200 text-xs text-slate-600 space-y-1.5">
                  <div class="font-bold text-slate-900">Best for:</div>
                  <div class="flex items-center gap-1.5"><span class="text-amber-500">•</span> Urgent product samples</div>
                  <div class="flex items-center gap-1.5"><span class="text-amber-500">•</span> Critical electronics &amp; chips</div>
                  <div class="flex items-center gap-1.5"><span class="text-amber-500">•</span> Person-to-person direct transit</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MOVE WITH CONFIDENCE CTA BANNER                                           -->
  <!-- ========================================================================= -->
  <section class="py-14 bg-[#11181E] text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-2 max-w-2xl text-center md:text-left">
          <span class="text-xs font-bold text-[#EA1D2C] uppercase tracking-wider block font-mono">
            Move with Confidence
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight">
            Looking for a Reliable China to Bangladesh Shipping Partner?
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Tell us what you need to ship and our team will help you choose the right shipping solution.
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-3 shrink-0">
          <a
            href="#quote-section"
            class="px-6 py-3 rounded-md bg-[#EA1D2C] text-white text-xs font-bold hover:bg-[#D01422] transition-colors duration-150"
          >
            Get a Quote
          </a>
          <a
            href="https://wa.me/8801797252627?text=Hello%20Go%20Shipping%2C%20I%20would%20like%20a%20shipping%20quote."
            target="_blank"
            rel="noreferrer"
            class="px-6 py-3 rounded-md border border-emerald-500/50 bg-emerald-950/40 text-emerald-300 text-xs font-bold hover:bg-emerald-900/60 transition-colors duration-150 inline-flex items-center gap-2"
          >
            WhatsApp Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. WHY GOSHIPPING: Why Businesses Choose Go Shipping                      -->
  <!-- ========================================================================= -->
  <section id="why-us" class="py-20 lg:py-28 bg-[#F8FAFC] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <span class="text-xs font-bold text-[#EA1D2C] uppercase tracking-wider block mb-3 font-mono">
        /WHY GO SHIPPING
      </span>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
        <div class="lg:col-span-7">
          <h2 class="text-3xl sm:text-5xl font-extrabold text-[#11181E] tracking-tight leading-[1.08]">
            Why Businesses Choose<br />
            <span class="text-slate-400 font-medium">Go Shipping.</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pl-6">
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
            Careful planning, transparent communication, and dedicated customer support at every stage of your China-to-Bangladesh supply chain.
          </p>
        </div>
      </div>

      {/* 6 Core Strengths Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {/* Strength 1: Reliable Service */}
        <div class="space-y-4 bg-white p-7 rounded-lg border border-slate-200 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-2xl font-black text-[#EA1D2C] font-mono">01</span>
              <div class="w-9 h-9 rounded-md bg-red-50 text-[#EA1D2C] flex items-center justify-center">
