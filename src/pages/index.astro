---
import PublicLayout from '../layouts/PublicLayout.astro';
import LiveTrackingIsland from '../components/marketing/LiveTrackingIsland';
import QuoteCalculatorIsland from '../components/marketing/QuoteCalculatorIsland';

export const prerender = true;
---

<PublicLayout title="GoShipping | High-Velocity Air & Ocean Freight Forwarding" currentPath="/">
  <!-- Above-the-fold Hero Section -->
  <section class="relative bg-slate-900 text-white overflow-hidden py-16 lg:py-24 border-b border-slate-800">
    <!-- Subtle technical grid background -->
    <div class="absolute inset-0 opacity-10 bg-[linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Copy -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800/90 border border-slate-700 text-xs font-semibold text-slate-300">
            <span class="w-2 h-2 rounded-full bg-[#EA1D2C]"></span>
            Licensed IATA & Chittagong Customs Clearing Agent #182
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-[1.15]">
            Global Freight Forwarding Engineered for Export Velocity.
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
            GoShipping accelerates international supply chains with dedicated air cargo allocations, consolidated ocean freight, bonded customs clearance, and verified checkpoint telemetry.
          </p>

          <!-- Core Action Triggers -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="#live-tracking"
              class="px-6 py-3.5 rounded-lg bg-[#EA1D2C] text-white font-bold text-sm tracking-wide hover:bg-[#D41523] active:bg-[#B7101C] transition-colors-fast shadow-md"
            >
              Track Live Consignment →
            </a>
            <a
              href="#quote-calculator"
              class="px-6 py-3.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-bold text-sm transition-colors-fast"
            >
              Calculate Freight Rate
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-6 border-t border-slate-800/80 grid grid-cols-3 gap-4 text-xs text-slate-400">
            <div>
              <p class="text-white font-extrabold text-lg sm:text-xl font-mono tabular-nums">48-72h</p>
              <p class="mt-0.5">Express Air Transit Europe & North America</p>
            </div>
            <div>
              <p class="text-white font-extrabold text-lg sm:text-xl font-mono tabular-nums">12,500+</p>
              <p class="mt-0.5">TEU Annual Ocean Volume Handled</p>
            </div>
            <div>
              <p class="text-white font-extrabold text-lg sm:text-xl font-mono tabular-nums">100%</p>
              <p class="mt-0.5">Verified Customs Compliance</p>
            </div>
          </div>
        </div>

        <!-- Hero Interactive Quick Search Panel -->
        <div class="lg:col-span-5">
          <div class="p-6 sm:p-8 rounded-2xl bg-white text-slate-900 shadow-2xl border border-slate-200">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#EA1D2C] block mb-1">
              Active Milestone Search
            </span>
            <h2 class="text-xl font-bold tracking-tight text-slate-900 mb-4">
              Real-Time Waypoint Tracking
            </h2>
            <form action="/tracking" method="GET" class="space-y-4">
              <div>
                <label for="tracking-input" class="block text-xs font-semibold text-slate-700 mb-1.5">
                  Master Airway Bill (MAWB) or Ocean B/L
                </label>
                <input
                  id="tracking-input"
                  name="code"
                  type="text"
                  defaultValue="GOSH-2026-9812"
                  placeholder="e.g. GOSH-2026-9812"
                  class="w-full h-11 px-3.5 rounded-lg border border-slate-300 font-mono text-sm uppercase focus:border-[#EA1D2C] focus:ring-1 focus:ring-[#EA1D2C]"
                  required
                />
              </div>
              <button
                type="submit"
                class="w-full h-11 rounded-lg bg-[#EA1D2C] text-white font-bold text-xs uppercase tracking-wider hover:bg-[#D41523] active:bg-[#B7101C] transition-colors-fast"
              >
                Inspect Consignment Status →
              </button>
            </form>

            <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
              <span class="font-medium">Active Network:</span>
              <span class="text-slate-700 font-semibold">DAC · CTG · DXB · FRA · GZ</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Tracking Interactive Section -->
  <section id="live-tracking" class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-wider text-[#EA1D2C]">
          Verified Checkpoint Telemetry
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#11181E] tracking-tight mt-1">
          Near-Real-Time Milestone Verification
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Tracking milestones are authenticated directly from airport cargo handlers, port berths, and bonded warehouses.
        </p>
      </div>

      <!-- React Live Tracking Island -->
      <LiveTrackingIsland client:load initialTrackingNumber="GOSH-2026-9812" pollIntervalMs={25000} />
    </div>
  </section>

  <!-- Core Freight Services Grid -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-[#EA1D2C]">Enterprise Logistics</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#11181E] tracking-tight mt-1">
          Multi-Modal Cargo Infrastructure
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Purpose-built freight lanes connecting industrial manufacturing facilities in Bangladesh with global consumer destinations.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Service 1: Air Cargo -->
        <div class="p-8 rounded-xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-colors-fast flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-lg bg-[#EA1D2C] text-white flex items-center justify-center font-bold text-xl">
              ✈
            </div>
            <h3 class="text-lg font-bold text-slate-900">Scheduled & Charter Air Freight</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Direct allocations with Tier-1 airlines (Emirates SkyCargo, Qatar Cargo, Saudia, Turkish Cargo) operating from Dhaka HSIA with expedited European and US transit.
            </p>
            <ul class="text-xs text-slate-500 space-y-1.5 pt-2">
              <li>✓ Guaranteed space during export peak seasons</li>
              <li>✓ GOH (Garment on Hanger) specialized handling</li>
              <li>✓ High-value & temperature-monitored shipments</li>
            </ul>
          </div>
          <div class="pt-6 mt-6 border-t border-slate-200">
            <a href="/services" class="text-xs font-bold text-[#EA1D2C] hover:underline">
              Explore Air Services →
            </a>
          </div>
        </div>

        <!-- Service 2: Ocean Freight -->
        <div class="p-8 rounded-xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-colors-fast flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-lg bg-slate-900 text-white flex items-center justify-center font-bold text-xl">
              🚢
            </div>
            <h3 class="text-lg font-bold text-slate-900">Ocean Freight (FCL / LCL Consolidation)</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Comprehensive container shipping via Chittagong Port and Mongla Port. Weekly consolidation boxes to Singapore, Colombo, Rotterdam, Hamburg, and US West/East Coast.
            </p>
            <ul class="text-xs text-slate-500 space-y-1.5 pt-2">
              <li>✓ Full Container Load (20ft, 40ft HC, Reefer)</li>
              <li>✓ Weekly buyer's consolidation at our CFS</li>
              <li>✓ Direct carrier contracts with Maersk, MSC, CMA CGM</li>
            </ul>
          </div>
          <div class="pt-6 mt-6 border-t border-slate-200">
            <a href="/services" class="text-xs font-bold text-[#EA1D2C] hover:underline">
              Explore Ocean Cargo →
            </a>
          </div>
        </div>

        <!-- Service 3: Customs & Bonded CFS -->
        <div class="p-8 rounded-xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-colors-fast flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-lg bg-slate-900 text-white flex items-center justify-center font-bold text-xl">
              ⚖
            </div>
            <h3 class="text-lg font-bold text-slate-900">Licensed Customs Brokerage</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              In-house licensed customs clearing at Dhaka Airport, Chittagong Custom House, and Benapole Land Port. ASYCUDA World electronic declaration integration.
            </p>
            <ul class="text-xs text-slate-500 space-y-1.5 pt-2">
              <li>✓ Duty calculation & HS Code verification</li>
              <li>✓ Bonded warehouse transfers & transit permits</li>
              <li>✓ Certificate of Origin, GSP, and export documentation</li>
            </ul>
          </div>
          <div class="pt-6 mt-6 border-t border-slate-200">
            <a href="/services" class="text-xs font-bold text-[#EA1D2C] hover:underline">
              Explore Customs Brokerage →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Quotation Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <QuoteCalculatorIsland client:visible />
    </div>
  </section>
</PublicLayout>
