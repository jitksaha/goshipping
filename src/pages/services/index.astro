---
import PublicLayout from '../../layouts/PublicLayout.astro';
import QuoteCalculatorIsland from '../../components/marketing/QuoteCalculatorIsland';

export const prerender = true;
---

<PublicLayout title="Services — Integrated Logistics Solutions | GoShipping" currentPath="/services">
  <!-- Services Header -->
  <div class="bg-white py-16 lg:py-24 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400 font-mono block mb-3">
        /OUR COMPREHENSIVE SERVICES
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[#11181E] font-['Manrope',sans-serif]">
        Integrated Logistics Solutions
      </h1>
      <p class="text-slate-600 text-sm max-w-2xl mt-4 leading-relaxed font-medium">
        We offer a comprehensive range of freight and customs services engineered to meet the high-velocity demands of global commerce.
      </p>
    </div>
  </div>

  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    <!-- Service 01: Ocean Freight -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-4">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#EA1D2C]">/01 — MARITIME</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-['Manrope',sans-serif]">
          Ocean Freight (FCL & LCL)
        </h2>
        <p class="text-xs text-slate-600 leading-relaxed font-medium">
          Direct allocations with global container lines including Maersk, MSC, and CMA CGM. Weekly buyer consolidation at our dedicated Chittagong CFS container freight station.
        </p>
        <div class="grid grid-cols-2 gap-4 pt-2 text-xs">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <h4 class="font-bold text-slate-900">Full Container Load (FCL)</h4>
            <p class="text-slate-500 mt-1">20ft, 40ft GP, High-Cube & temperature-controlled reefers.</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <h4 class="font-bold text-slate-900">LCL Buyer's Box</h4>
            <p class="text-slate-500 mt-1">Multi-vendor consolidation into a single export manifest.</p>
          </div>
        </div>
      </div>
      <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-sm border border-slate-200 aspect-[16/10]">
        <img
          src="https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?auto=format&fit=crop&w=1200&q=80"
          alt="Ocean shipping container logistics"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Service 02: Air Cargo -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center pt-8 border-t border-slate-100">
      <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-sm border border-slate-200 aspect-[16/10] order-2 lg:order-1">
        <img
          src="https://images.unsplash.com/photo-1542296332-2e4473faf563?auto=format&fit=crop&w=1200&q=80"
          alt="Air cargo tarmac loading"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="lg:col-span-6 space-y-4 order-1 lg:order-2">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#EA1D2C]">/02 — AVIATION</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-['Manrope',sans-serif]">
          Scheduled & Charter Air Freight
        </h2>
        <p class="text-xs text-slate-600 leading-relaxed font-medium">
          When time-to-market is non-negotiable, our blocked space agreements with Tier-1 carriers out of Dhaka HSIA provide 48–72 hour transatlantic and European turnaround.
        </p>
        <div class="grid grid-cols-2 gap-4 pt-2 text-xs">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <h4 class="font-bold text-slate-900">Garment-On-Hanger (GOH)</h4>
            <p class="text-slate-500 mt-1">Specialized airline container rigs for wrinkle-free retail delivery.</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <h4 class="font-bold text-slate-900">Priority Charters</h4>
            <p class="text-slate-500 mt-1">Dedicated freighter flights for critical volume deadlines.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Service 03: Warehousing & Customs -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center pt-8 border-t border-slate-100">
      <div class="lg:col-span-6 space-y-4">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#EA1D2C]">/03 — CONTRACT LOGISTICS</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-['Manrope',sans-serif]">
          Warehousing & Licensed Customs Brokerage
        </h2>
        <p class="text-xs text-slate-600 leading-relaxed font-medium">
          Operating under Chittagong Customs Clearing Agent License #182 with direct ASYCUDA electronic filing, bonded transshipments, and climate-controlled storage.
        </p>
        <div class="grid grid-cols-2 gap-4 pt-2 text-xs">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <h4 class="font-bold text-slate-900">Bonded CFS Depots</h4>
            <p class="text-slate-500 mt-1">200,000+ sq. ft. of barcode-tracked capacity.</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <h4 class="font-bold text-slate-900">Fast Customs Release</h4>
            <p class="text-slate-500 mt-1">HS code validation, Duty assessments & GSP certificates.</p>
          </div>
        </div>
      </div>
      <div class="lg:col-span-6 rounded-2xl overflow-hidden shadow-sm border border-slate-200 aspect-[16/10]">
        <img
          src="https://images.unsplash.com/photo-1553413077-190dd305871c?auto=format&fit=crop&w=1200&q=80"
          alt="Modern logistics warehouse storage"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Quote Section -->
  <section class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <QuoteCalculatorIsland client:visible />
    </div>
  </section>
</PublicLayout>
