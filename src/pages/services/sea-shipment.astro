---
import PublicLayout from '../../layouts/PublicLayout.astro';
import QuoteCalculatorIsland from '../../components/marketing/QuoteCalculatorIsland';
import { getSiteOrigin } from '../../server/utils/domain';

const siteOrigin = getSiteOrigin(Astro.request);
const canonicalUrl = `${siteOrigin}/services/sea-shipment`;

const faqItems = [
  {
    q: "How long does sea shipment take from China to Chittagong?",
    a: "Direct ocean transit from South China ports (Guangzhou Nansha, Shenzhen Shekou/Yantian) to Chittagong Port (CGP) takes approximately 18 to 25 days. Including port congestion, customs clearance, and terminal release, total door-to-door delivery typically takes 35 to 45 days."
  },
  {
    q: "What is the difference between FCL and LCL sea freight?",
    a: "FCL (Full Container Load) reserves an entire 20ft or 40ft shipping container exclusively for your cargo. LCL (Less than Container Load) allows you to pay only for the volume (CBM) your cargo occupies, sharing a consolidated container with other vetted commercial shipments."
  },
  {
    q: "What is the minimum volume required for sea shipment?",
    a: "For LCL shared container shipments, our minimum booking volume is just 1.0 CBM (Cubic Meter). For FCL, standard container sizes are 20ft GP (approx. 28 CBM), 40ft GP (approx. 58 CBM), and 40ft High Cube (approx. 68 CBM)."
  },
  {
    q: "Are Chittagong port charges and customs included?",
    a: "We offer both DDP (all-inclusive door-to-door including port handling and customs clearance) as well as port-to-port B/L release for corporate importers who have their own C&F agents and IRC licenses."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${siteOrigin}/services/sea-shipment#service`,
      "name": "China to Bangladesh Sea Freight & Container Shipping Services",
      "serviceType": "Ocean Freight Forwarding",
      "provider": {
        "@type": "LogisticsService",
        "@id": `${siteOrigin}/#organization`,
        "name": "Go Shipping"
      },
      "areaServed": [
        { "@type": "Country", "name": "Bangladesh" },
        { "@type": "Country", "name": "China" }
      ],
      "description": "Cost-effective Full Container Load (FCL) and Less than Container Load (LCL) ocean freight from all major China ports to Chittagong Port and Dhaka, Bangladesh.",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "BDT",
        "price": "18500.00",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "18500.00",
          "priceCurrency": "BDT",
          "unitText": "CBM"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteOrigin },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteOrigin}/services` },
        { "@type": "ListItem", "position": 3, "name": "Sea Shipment", "item": canonicalUrl }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<PublicLayout
  title="Sea Shipment China to Bangladesh | FCL & LCL Ocean Freight — Go Shipping"
  description="Cost-effective sea freight solutions from China ports to Chittagong Port and Dhaka. Full Container Load (FCL) and Less than Container Load (LCL) with full customs clearance."
  keywords="sea shipment china to bangladesh, ocean freight guangzhou to chittagong, fcl lcl container shipping bangladesh, china sea cargo bangladesh, ctg port clearance, container shipping rates china bd"
  currentPath="/services/sea-shipment"
  image="/og/og-sea-shipment.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- Hero Banner -->
  <section class="bg-[#11181E] text-white py-16 lg:py-24 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs font-mono text-[#EA1D2C] uppercase tracking-wider mb-3">
        <a href="/services" class="hover:underline text-slate-400">Services</a>
        <span>/</span>
        <span>Ocean Freight</span>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-8 space-y-4">
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight font-['Manrope',sans-serif] leading-tight">
            China to Bangladesh Sea Shipment
          </h1>
          <p class="text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
            Economical, large-volume maritime shipping connecting Guangzhou Nansha, Shenzhen Shekou/Yantian, Ningbo, and Shanghai to Chittagong Port (CGP) and Dhaka Inland Container Depot (ICD).
          </p>
          <div class="flex flex-wrap gap-4 pt-4 text-xs">
            <div class="bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-2.5 rounded-md">
              <span class="text-slate-400 block text-[10px] uppercase font-mono">Transit Time</span>
              <span class="font-bold text-white text-sm">35–45 Days</span>
            </div>
            <div class="bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-2.5 rounded-md">
              <span class="text-slate-400 block text-[10px] uppercase font-mono">Service Options</span>
              <span class="font-bold text-white text-sm">FCL & LCL Shared</span>
            </div>
            <div class="bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-2.5 rounded-md">
              <span class="text-slate-400 block text-[10px] uppercase font-mono">Minimum Volume</span>
              <span class="font-bold text-white text-sm">1.0 CBM</span>
            </div>
            <div class="bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-2.5 rounded-md">
              <span class="text-slate-400 block text-[10px] uppercase font-mono">Discharge Ports</span>
              <span class="font-bold text-white text-sm">Chittagong & Mongla</span>
            </div>
          </div>
        </div>
        <div class="lg:col-span-4 flex flex-col gap-3">
          <a href="#quote-calculator" class="w-full text-center py-3 px-6 bg-[#EA1D2C] hover:bg-[#D41523] text-white font-bold text-sm rounded-md transition-colors shadow-sm">
            Calculate Sea Rate
          </a>
          <a href="https://wa.me/8801797252627?text=Hello%20Go%20Shipping%2C%20I%20need%20Sea%20Shipment%20from%20China." target="_blank" rel="noreferrer" class="w-full text-center py-3 px-6 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-md transition-colors">
            WhatsApp Ocean Desk
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Details -->
  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    <!-- Comparison Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="p-6 lg:p-8 rounded-lg bg-white border border-slate-200 space-y-4">
        <span class="text-xs font-mono font-bold text-[#EA1D2C] uppercase tracking-wider">/LCL CONSOLIDATION</span>
        <h3 class="text-xl font-bold text-slate-900 font-['Manrope']">LCL (Less than Container Load)</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          The ideal choice for small to medium enterprises, online sellers, and wholesale importers who do not have enough cargo to fill a whole container. You pay solely for the cubic meters (CBM) your cartons occupy.
        </p>
        <ul class="text-xs text-slate-600 space-y-2.5 pt-2 border-t border-slate-100">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Minimum booking starts from only 1.0 CBM</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Multi-supplier consolidation at our Guangzhou & Yiwu warehouses</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>All-inclusive DDP customs clearance and door delivery available</span>
          </li>
        </ul>
      </div>

      <div class="p-6 lg:p-8 rounded-lg bg-white border border-slate-200 space-y-4">
        <span class="text-xs font-mono font-bold text-[#EA1D2C] uppercase tracking-wider">/FCL FULL CONTAINER</span>
        <h3 class="text-xl font-bold text-slate-900 font-['Manrope']">FCL (Full Container Load)</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Dedicated shipping containers exclusively for your factory orders. Empty containers are dispatched directly to your China manufacturer's loading dock, sealed with customs bolt seals, and shipped uninterrupted to Bangladesh.
        </p>
        <ul class="text-xs text-slate-600 space-y-2.5 pt-2 border-t border-slate-100">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>20ft GP, 40ft GP, and 40ft High Cube (HQ) availability</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Competitive contract freight rates with Maersk, MSC, COSCO, and ONE</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Comprehensive B/L, Commercial Invoice, and Port Clearance support</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Container Specifications Table -->
    <div class="bg-slate-50 border border-slate-200 rounded-lg p-6 lg:p-10 space-y-6">
      <div class="space-y-1">
        <span class="text-xs font-mono font-bold text-[#EA1D2C] uppercase tracking-wider">/SPECIFICATIONS</span>
        <h2 class="text-2xl font-bold text-slate-900 font-['Manrope']">Standard Shipping Container Capacities</h2>
        <p class="text-xs text-slate-600">Select the right container type for your commercial cargo volume and weight.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-700 border-collapse">
          <thead>
            <tr class="border-b border-slate-300 font-mono text-slate-900 font-bold bg-slate-100">
              <th class="p-3">Container Type</th>
              <th class="p-3">Internal Dimensions (L×W×H)</th>
              <th class="p-3">Usable Volume</th>
              <th class="p-3">Max Payload Weight</th>
              <th class="p-3">Best Suited For</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <tr>
              <td class="p-3 font-bold text-slate-900">20ft Standard (GP)</td>
              <td class="p-3 font-mono">5.90 × 2.35 × 2.39 m</td>
              <td class="p-3 font-mono">28–30 CBM</td>
              <td class="p-3 font-mono">~21,800 KG</td>
              <td class="p-3">Heavy, dense goods (metals, raw minerals, hardware)</td>
            </tr>
            <tr>
              <td class="p-3 font-bold text-slate-900">40ft Standard (GP)</td>
              <td class="p-3 font-mono">12.03 × 2.35 × 2.39 m</td>
              <td class="p-3 font-mono">58–60 CBM</td>
              <td class="p-3 font-mono">~26,500 KG</td>
              <td class="p-3">General merchandise, apparel, furniture</td>
            </tr>
            <tr>
              <td class="p-3 font-bold text-slate-900">40ft High Cube (HQ)</td>
              <td class="p-3 font-mono">12.03 × 2.35 × 2.69 m</td>
              <td class="p-3 font-mono">68–70 CBM</td>
              <td class="p-3 font-mono">~26,500 KG</td>
              <td class="p-3">Bulky, high-volume products (textiles, footwear, electronics)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Interactive Calculator -->
    <div id="quote-calculator" class="pt-4">
      <QuoteCalculatorIsland client:visible initialMode="sea" />
    </div>

    <!-- FAQ Section -->
    <div class="space-y-6 pt-8">
      <div class="space-y-2">
        <h2 class="text-2xl font-bold text-slate-900 font-['Manrope']">Sea Shipment Frequently Asked Questions</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {faqItems.map(item => (
          <div class="p-6 rounded-lg bg-white border border-slate-200 space-y-2">
            <h3 class="text-sm font-bold text-slate-900 font-['Manrope']">{item.q}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</PublicLayout>
