---
import '../../styles/global.css';
import { getSiteOrigin } from '../../server/utils/domain';

const message = Astro.url.searchParams.get('message') || '';
const siteOrigin = getSiteOrigin(Astro.request);
const rawHost = Astro.request.headers.get('host') || Astro.url.hostname;
const hostname = rawHost.split(':')[0].toLowerCase();
const isLiveDomain = hostname.includes('goshipping.com.bd');
const publicCustomerPortalUrl = isLiveDomain ? 'https://goshipping.com.bd/login' : '/login';
---

<!doctype html>
<html lang="en" class="overflow-x-clip bg-[#070B0E]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="alternate icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <title>Enterprise Command Console | Super Admin Gateway</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#070B0E] text-slate-100 min-h-screen flex flex-col justify-between font-['Inter',sans-serif] overflow-x-clip antialiased selection:bg-[#EA1D2C] selection:text-white">
    
    <!-- Top Global Security Telemetry Bar -->
    <header class="w-full border-b border-slate-800/80 bg-[#0A0F14]/90 backdrop-blur px-4 py-2.5 flex items-center justify-between text-[11px] font-mono text-slate-400">
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5 text-emerald-400 font-semibold">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>SYSTEM ACTIVE</span>
        </div>
        <span class="text-slate-700">|</span>
        <span class="hidden sm:inline text-slate-400">NODE: CLOUDFLARE ANYCAST [DAC]</span>
        <span class="hidden sm:inline text-slate-700">|</span>
        <span class="hidden md:inline text-slate-400">GATEWAY: <strong class="text-slate-200">{hostname}</strong></span>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5 text-slate-300">
          <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <span id="live-telemetry-clock">00:00:00 UTC</span>
        </div>
      </div>
    </header>

    <!-- Main Command Console Canvas -->
    <main class="flex-1 flex items-center justify-center p-4 sm:p-6 lg:p-10 relative">
      
      <!-- Subtle Tactical Grid Overlay -->
      <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(#1E293B_1px,transparent_1px)] [background-size:24px_24px] opacity-25"></div>

      <!-- Split Console Card -->
      <div class="w-full max-w-[1020px] bg-[#0E141B] rounded-2xl border border-slate-800 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.85)] overflow-hidden grid grid-cols-1 lg:grid-cols-12 relative z-10">
        
        <!-- Left Side: Mission Control Overview & Telemetry -->
        <div class="lg:col-span-5 bg-[#0A0F14] p-6 sm:p-8 lg:p-10 border-b lg:border-b-0 lg:border-r border-slate-800/80 flex flex-col justify-between space-y-8">
          
          <!-- Brand & Clearance Badge -->
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <a href="/" class="inline-flex items-center" aria-label="GoShipping Home">
                <img
                  src="/brand/logo-light.svg"
                  alt="GoShipping Enterprise"
                  class="h-9 w-auto object-contain brightness-110"
                />
              </a>
              <span class="px-2.5 py-1 rounded-sm bg-red-950/80 border border-red-700/60 text-red-400 font-mono text-[10px] font-bold tracking-widest uppercase">
                ROOT ZONE
              </span>
            </div>

            <div class="space-y-2">
              <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-white font-['Manrope',sans-serif]">
                Enterprise Command Nexus
              </h1>
              <p class="text-xs text-slate-400 leading-relaxed font-normal">
                Restricted gateway for master ledger administration, carrier routing, air/ocean manifests, and customs operations.
              </p>
            </div>
          </div>

          <!-- Live Audit Log Stream Feed -->
          <div class="space-y-2.5">
            <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
              <span class="font-semibold text-slate-300">SECURITY TELEMETRY</span>
              <span class="text-emerald-400 text-[10px]">ENFORCED</span>
            </div>
            
            <div class="p-3.5 rounded-lg bg-[#070B0E] border border-slate-800 font-mono text-[11px] space-y-1.5 text-slate-400 shadow-inner">
              <div class="flex items-center gap-2">
                <span class="text-slate-600">01</span>
                <span class="text-slate-300">TLS 1.3 / AES-256 Hardware Encrypted</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-slate-600">02</span>
                <span class="text-amber-400/90">Isolated Root Gateway Session Protocol</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-slate-600">03</span>
                <span class="text-emerald-400">Real-time Forensic Telemetry Active</span>
              </div>
              <div class="flex items-center gap-2 text-slate-500 text-[10px]">
                <span class="text-slate-600">04</span>
                <span>Audit Trail: Direct Hostinger CageFS Node</span>
              </div>
            </div>
          </div>

          <!-- Clearance Specs Footer -->
          <div class="pt-4 border-t border-slate-800/80 text-[11px] text-slate-500 font-mono flex items-center justify-between">
            <span>CLEARANCE: LEVEL 5 (SUPER ADMIN)</span>
            <span class="text-slate-400">v1.2.4-PROD</span>
          </div>
        </div>

        <!-- Right Side: The Authentication Console -->
        <div class="lg:col-span-7 p-6 sm:p-10 lg:p-12 flex flex-col justify-between space-y-6">
          
          <div class="space-y-6">
            <!-- Header Title -->
            <div class="space-y-1.5">
              <div class="inline-flex items-center gap-1.5 text-[11px] font-mono text-[#EA1D2C] uppercase tracking-wider font-bold">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <span>Privileged Authentication Console</span>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-white font-['Manrope',sans-serif]">
                Sign In to Command Center
              </h2>
              <p class="text-xs text-slate-400">
                Provide authorized master credentials to initiate administrative session.
              </p>
            </div>

            <!-- Logout Confirmation Message -->
            {message === 'logged_out' && (
              <div class="p-3.5 rounded-lg bg-emerald-950/60 border border-emerald-800/80 text-xs text-emerald-300 font-medium flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>Your administrative session was terminated safely.</span>
              </div>
            )}

            <!-- Interactive Error Alert Box -->
            <div id="admin-error-box" class="hidden p-3.5 rounded-lg bg-red-950/70 border border-red-800/90 text-xs text-red-200 font-medium leading-relaxed space-y-1">
              <div class="font-bold flex items-center gap-1.5 text-red-400">
                <svg class="w-4 h-4 shrink-0 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span id="admin-error-title">Authentication Failed</span>
              </div>
              <p id="admin-error-msg" class="text-xs text-red-300"></p>
            </div>

            <!-- Authentication Form -->
            <form id="admin-login-form" class="space-y-4 text-xs">
              
              <!-- Master Identity / Email -->
              <div class="space-y-1.5">
                <label for="admin-email" class="block font-semibold text-slate-300">
                  Master Administrator Email
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="4" width="20" height="16" rx="2" />
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                  </div>
                  <input
                    id="admin-email"
                    type="email"
                    required
                    autocomplete="email"
                    placeholder="mail.jitsaha@gmail.com"
                    class="w-full h-11 pl-10 pr-3.5 rounded-lg bg-[#141B23] border border-slate-700/80 hover:border-slate-600 focus:bg-[#18212B] focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/20 text-sm text-white placeholder-slate-500 font-mono transition-colors outline-none"
                  />
                </div>
              </div>

              <!-- Master Security Key / Password -->
              <div class="space-y-1.5">
                <div class="flex justify-between items-center">
                  <label for="admin-password" class="block font-semibold text-slate-300">
                    Master Password
                  </label>
                  <span id="caps-lock-warning" class="hidden text-[11px] font-mono text-amber-400 font-semibold flex items-center gap-1">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 15-6-6-6 6"/></svg>
                    CAPS LOCK IS ON
                  </span>
                </div>
                
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                      <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                  </div>
                  
                  <input
                    id="admin-password"
                    type="password"
                    required
                    autocomplete="current-password"
                    placeholder="••••••••••••"
                    class="w-full h-11 pl-10 pr-10 rounded-lg bg-[#141B23] border border-slate-700/80 hover:border-slate-600 focus:bg-[#18212B] focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/20 text-sm text-white placeholder-slate-500 font-mono transition-colors outline-none"
                  />

                  <!-- Password Visibility Toggle Button -->
                  <button
                    type="button"
                    id="btn-toggle-password"
                    class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-500 hover:text-slate-300 transition-colors cursor-pointer"
                    aria-label="Toggle password visibility"
                  >
                    <svg id="eye-icon-show" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                    <svg id="eye-icon-hide" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24" />
                      <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68" />
                      <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61" />
                      <line x1="2" x2="22" y1="2" y2="22" />
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Remember Session -->
              <div class="flex items-center justify-between pt-1">
                <label class="flex items-center gap-2 cursor-pointer text-slate-400 hover:text-slate-300 transition-colors">
                  <input
                    type="checkbox"
                    id="remember-session"
                    checked
                    class="w-4 h-4 rounded border-slate-700 bg-[#141B23] text-[#EA1D2C] focus:ring-[#EA1D2C]/20 accent-[#EA1D2C]"
                  />
                  <span>Persist Root Session (30 Days)</span>
                </label>
                <span class="text-[11px] font-mono text-slate-500">Hardware Sealed</span>
              </div>

              <!-- Main Submission Button -->
              <button
                type="submit"
                id="admin-submit-btn"
                class="w-full h-11 mt-3 rounded-lg bg-[#EA1D2C] text-white font-semibold text-sm hover:bg-[#D41523] active:bg-[#B7101C] transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-red-950/40 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <span id="admin-btn-label">Authenticate & Access Command Center →</span>
              </button>
            </form>
          </div>

          <!-- Bottom Links -->
          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-500">
            <a
              href={publicCustomerPortalUrl}
              class="hover:text-slate-300 transition-colors inline-flex items-center gap-1.5"
            >
              <span>← Public Customer Portal</span>
            </a>
            <span class="font-mono text-[10px] text-slate-600">IP: AUDITED</span>
          </div>

        </div>

      </div>
    </main>

    <!-- Bottom Global Footer -->
    <footer class="w-full border-t border-slate-800/80 bg-[#0A0F14]/90 px-4 py-2.5 text-center text-[11px] text-slate-500 font-mono">
      <span>GoShipping Enterprise Defense Layer · Authorized Root Operators Only · Unlawful Access Prohibited</span>
    </footer>

    <!-- Client-Side Script -->
    <script>
      // Live Ticking Clock (UTC)
      function updateClock() {
        const clockEl = document.getElementById('live-telemetry-clock');
        if (!clockEl) return;
        const now = new Date();
        const utcHours = String(now.getUTCHours()).padStart(2, '0');
        const utcMinutes = String(now.getUTCMinutes()).padStart(2, '0');
        const utcSeconds = String(now.getUTCSeconds()).padStart(2, '0');
        clockEl.textContent = `${utcHours}:${utcMinutes}:${utcSeconds} UTC`;
      }
      setInterval(updateClock, 1000);
      updateClock();

      // Password Toggle
      const passInput = document.getElementById('admin-password');
      const toggleBtn = document.getElementById('btn-toggle-password');
      const eyeShow = document.getElementById('eye-icon-show');
      const eyeHide = document.getElementById('eye-icon-hide');

      toggleBtn?.addEventListener('click', () => {
        if (!passInput) return;
        const isPass = passInput.type === 'password';
        passInput.type = isPass ? 'text' : 'password';
        if (eyeShow && eyeHide) {
          eyeShow.classList.toggle('hidden', isPass);
          eyeHide.classList.toggle('hidden', !isPass);
        }
      });

      // Caps Lock Detection
      const capsWarning = document.getElementById('caps-lock-warning');
      function checkCapsLock(e) {
        if (!capsWarning) return;
        if (e.getModifierState && e.getModifierState('CapsLock')) {
          capsWarning.classList.remove('hidden');
        } else {
          capsWarning.classList.add('hidden');
        }
      }
      passInput?.addEventListener('keydown', checkCapsLock);
      passInput?.addEventListener('keyup', checkCapsLock);

      // Form Submission
      const form = document.getElementById('admin-login-form');
      const errorBox = document.getElementById('admin-error-box');
      const errorMsg = document.getElementById('admin-error-msg');
      const submitBtn = document.getElementById('admin-submit-btn');
      const btnLabel = document.getElementById('admin-btn-label');

      async function executeAdminLogin(email, password) {
        if (!errorBox || !submitBtn || !btnLabel || !errorMsg) return;
        errorBox.classList.add('hidden');
        submitBtn.setAttribute('disabled', 'true');
        btnLabel.textContent = 'Verifying Root Credentials...';

        try {
          const res = await fetch('/api/auth/admin-login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });

          const data = await res.json();
          if (!res.ok) {
            throw new Error(data.error || 'Authentication failed');
          }

          btnLabel.textContent = 'Authorized. Launching Console...';

          setTimeout(() => {
            window.location.replace('/admin');
          }, 350);
        } catch (err) {
          errorMsg.textContent = err.message || 'Access denied. Please check your credentials.';
          errorBox.classList.remove('hidden');
          submitBtn.removeAttribute('disabled');
          btnLabel.textContent = 'Authenticate & Access Command Center →';
        }
      }

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const emailInput = document.getElementById('admin-email');
        const email = emailInput ? emailInput.value.trim() : '';
        const password = passInput ? passInput.value : '';
        if (email && password) {
          executeAdminLogin(email, password);
        }
      });
    </script>
  </body>
</html>
