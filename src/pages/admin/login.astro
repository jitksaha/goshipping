---
import '../../styles/global.css';
import { getSiteOrigin } from '../../server/utils/domain';

const message = Astro.url.searchParams.get('message') || '';
const errorParam = Astro.url.searchParams.get('error') || '';
const siteOrigin = getSiteOrigin(Astro.request);
---

<!doctype html>
<html lang="en" class="overflow-x-clip bg-[#F8FAFC]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="alternate icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <title>Super Admin Gateway | GoShipping</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#F8FAFC] text-slate-900 min-h-screen flex items-center justify-center p-4 sm:p-6 font-['Inter',sans-serif] overflow-x-clip antialiased selection:bg-[#EA1D2C] selection:text-white">
    
    <!-- Ultra-Minimal White Mode Card -->
    <main class="w-full max-w-[400px] bg-white rounded-2xl border border-slate-200/90 shadow-[0_10px_35px_-8px_rgba(15,23,42,0.08)] p-7 sm:p-9 space-y-6">
      
      <!-- Logo & Clean Minimal Heading -->
      <div class="text-center space-y-3">
        <div class="inline-flex items-center justify-center">
          <img
            src="/brand/logo-light.svg"
            alt="GoShipping"
            class="h-9 w-auto object-contain"
          />
        </div>
        <div class="space-y-1">
          <h1 class="text-xl font-bold tracking-tight text-slate-900 font-['Manrope',sans-serif]">
            Admin Gateway
          </h1>
          <p class="text-xs text-slate-400 font-normal">
            Authorized personnel only
          </p>
        </div>
      </div>

      <!-- Logout / Status Messages -->
      {errorParam === 'account_suspended' && (
        <div class="p-3 rounded-lg bg-rose-50 border border-rose-200 text-xs text-rose-800 font-medium flex items-center gap-2">
          <svg class="w-4 h-4 text-rose-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <span>This administrative account has been suspended. Please contact system administrator.</span>
        </div>
      )}
      {message === 'logged_out' && (
        <div class="p-3 rounded-lg bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 font-medium flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          <span>Signed out successfully.</span>
        </div>
      )}

      <!-- Error Alert Box -->
      <div id="admin-error-box" class="hidden p-3 rounded-lg bg-rose-50 border border-rose-200 text-xs text-rose-700 font-medium leading-relaxed"></div>

      <!-- Form: Just Email and Password -->
      <form id="admin-login-form" class="space-y-4 text-xs">
        
        <!-- Email or Phone Input -->
        <div class="space-y-1.5">
          <label for="admin-email" class="block font-semibold text-slate-700">
            Work Email or Phone Number
          </label>
          <input
            id="admin-email"
            type="text"
            required
            autocomplete="username"
            placeholder="admin@goshipping.com or 017XXXXXXXX"
            class="w-full h-11 px-3.5 rounded-lg bg-[#F8FAFC] border border-slate-200 hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-sm text-slate-900 transition-colors outline-none"
          />
        </div>

        <!-- Password Input -->
        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <label for="admin-password" class="block font-semibold text-slate-700">
              Password
            </label>
            <span id="caps-lock-warning" class="hidden text-[10px] font-medium text-amber-600">
              Caps Lock on
            </span>
          </div>
          
          <div class="relative">
            <input
              id="admin-password"
              type="password"
              required
              autocomplete="current-password"
              class="w-full h-11 pl-3.5 pr-10 rounded-lg bg-[#F8FAFC] border border-slate-200 hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-sm text-slate-900 transition-colors outline-none"
            />
            
            <!-- Minimal Password Visibility Toggle -->
            <button
              type="button"
              id="btn-toggle-password"
              class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 transition-colors cursor-pointer"
              aria-label="Toggle password"
            >
              <svg id="eye-icon-show" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              <svg id="eye-icon-hide" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24" />
                <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68" />
                <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61" />
                <line x1="2" x2="22" y1="2" y2="22" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          id="admin-submit-btn"
          class="w-full h-11 mt-2 rounded-lg bg-[#EA1D2C] text-white font-semibold text-sm hover:bg-[#D41523] active:bg-[#B7101C] transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-sm disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="admin-btn-label">Sign In</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </button>
      </form>

      <!-- Minimalist Security Footer Line -->
      <div class="pt-2 text-center">
        <span class="text-[11px] text-slate-400 font-normal">
          Encrypted TLS session · Protected by GoShipping
        </span>
      </div>

    </main>

    <!-- Client-Side Form Logic -->
    <script>
      // Password visibility toggle
      const passInput = document.getElementById('admin-password');
      const toggleBtn = document.getElementById('btn-toggle-password');
      const eyeShow = document.getElementById('eye-icon-show');
      const eyeHide = document.getElementById('eye-icon-hide');

      toggleBtn?.addEventListener('click', () => {
        if (!passInput) return;
        const isPass = passInput.type === 'password';
        passInput.type = isPass ? 'text' : 'password';
        if (eyeShow && eyeHide) {
          eyeShow.classList.toggle('hidden', isPass);
          eyeHide.classList.toggle('hidden', !isPass);
        }
      });

      // Caps Lock detection
      const capsWarning = document.getElementById('caps-lock-warning');
      function checkCapsLock(e) {
        if (!capsWarning) return;
        if (e.getModifierState && e.getModifierState('CapsLock')) {
          capsWarning.classList.remove('hidden');
        } else {
          capsWarning.classList.add('hidden');
        }
      }
      passInput?.addEventListener('keydown', checkCapsLock);
      passInput?.addEventListener('keyup', checkCapsLock);

      // Submission
      const form = document.getElementById('admin-login-form');
      const errorBox = document.getElementById('admin-error-box');
      const submitBtn = document.getElementById('admin-submit-btn');
      const btnLabel = document.getElementById('admin-btn-label');

      async function executeAdminLogin(email, password) {
        if (!errorBox || !submitBtn || !btnLabel) return;
        errorBox.classList.add('hidden');
        submitBtn.setAttribute('disabled', 'true');
        btnLabel.textContent = 'Authenticating...';

        try {
          const res = await fetch('/api/auth/admin-login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });

          const data = await res.json();
          if (!res.ok) {
            throw new Error(data.error || 'Authentication failed');
          }

          if (data.token) {
            const isGoshippingDomain = window.location.hostname.includes('goshipping.com.bd');
            const domainStr = isGoshippingDomain ? '; domain=.goshipping.com.bd' : '';
            const secureStr = window.location.protocol === 'https:' ? '; secure' : '';
            document.cookie = `goshipping_admin_session=${encodeURIComponent(data.token)}; path=/; max-age=2592000; SameSite=Lax${domainStr}${secureStr}`;
          }

          btnLabel.textContent = 'Redirecting...';
          const params = new URLSearchParams(window.location.search);
          const targetRedirect = params.get('redirect') || data.redirectUrl || '/admin';
          setTimeout(() => {
            window.location.replace(targetRedirect);
          }, 150);
        } catch (err) {
          errorBox.textContent = err.message || 'Access denied';
          errorBox.classList.remove('hidden');
          submitBtn.removeAttribute('disabled');
          btnLabel.textContent = 'Sign In';
        }
      }

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const emailInput = document.getElementById('admin-email');
        const email = emailInput ? emailInput.value.trim() : '';
        const password = passInput ? passInput.value : '';
        if (email && password) {
          executeAdminLogin(email, password);
        }
      });
    </script>
  </body>
</html>
