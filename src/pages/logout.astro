---
import { destroySession } from '../server/auth/session';

const rawHost =
  Astro.request.headers.get('x-forwarded-host') ||
  Astro.request.headers.get('host') ||
  Astro.url.hostname;
const hostname = rawHost.split(':')[0].toLowerCase();
const isAdminHost = hostname.startsWith('admin.') || hostname.startsWith('superadmin.') || hostname.includes('admin.goshipping');
const portalParam = Astro.url.searchParams.get('portal');
const isAdmin = isAdminHost || portalParam === 'admin';

// Extract session cookie depending on admin or customer context
const adminCookie = Astro.cookies.get('goshipping_admin_session')?.value;
const customerCookie = Astro.cookies.get('goshipping_session')?.value;

if (isAdmin && adminCookie) {
  await destroySession(adminCookie);
} else if (customerCookie) {
  await destroySession(customerCookie);
}

// Invalidate cookies across both host-only and domain-wide scopes
if (isAdmin) {
  Astro.cookies.delete('goshipping_admin_session', { path: '/' });
  if (hostname.includes('goshipping.com.bd')) {
    Astro.cookies.delete('goshipping_admin_session', { path: '/', domain: '.goshipping.com.bd' });
  }
} else {
  Astro.cookies.delete('goshipping_session', { path: '/' });
  if (hostname.includes('goshipping.com.bd')) {
    Astro.cookies.delete('goshipping_session', { path: '/', domain: '.goshipping.com.bd' });
  }
}

// Redirect to appropriate login gateway
if (isAdmin) {
  return Astro.redirect('/admin/login?message=logged_out');
}
return Astro.redirect('/login?message=logged_out');
---
