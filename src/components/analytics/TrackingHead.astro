---
import type { TrackingConfig } from '../../server/utils/tracking';

interface Props {
  config: TrackingConfig;
  siteOrigin: string;
}

const { config, siteOrigin } = Astro.props;
---

<!-- Analytics & Tag Management Layer (GTM, Meta Pixel, TikTok, GA4, LinkedIn) -->
<script is:inline define:vars={{
  gtmId: config.gtmId,
  fbPixelId: config.fbPixelId,
  gaMeasurementId: config.gaMeasurementId,
  tiktokPixelId: config.tiktokPixelId,
  linkedinPartnerId: config.linkedinPartnerId,
  siteOrigin: siteOrigin
}}>
  (function() {
    // 1. Initialize Universal DataLayer
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      'site_origin': siteOrigin,
      'site_host': window.location.hostname,
      'site_platform': 'GoShipping Engine'
    });

    // 2. Google Tag Manager (GTM)
    if (gtmId) {
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',gtmId);
    }

    // 3. Meta (Facebook) Pixel
    if (fbPixelId) {
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      window.fbq('init', fbPixelId);
      window.fbq('track', 'PageView');
    }

    // 4. TikTok Pixel
    if (tiktokPixelId) {
      !function (w, d, t) {
        w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie","holdConsent","revokeConsent","grantConsent"],ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};ttq.load=function(e,n){var r="https://analytics.tiktok.com/i18n/pixel/events.js",o=n&&n.partner;ttq._i=ttq._i||{},ttq._i[e]=[],ttq._i[e]._u=r,ttq._t=ttq._t||{},ttq._t[e]=+new Date,ttq._o=ttq._o||{},ttq._o[e]=n||{};var a=document.createElement("script");a.type="text/javascript",a.async=!0,a.src=r+"?sdkid="+e+"&lib="+t;var c=document.getElementsByTagName("script")[0];c.parentNode.insertBefore(a,c)};
        ttq.load(tiktokPixelId);
        ttq.page();
      }(window, document, 'ttq');
    }

    // 5. Standalone Google Analytics 4 (if configured without GTM)
    if (gaMeasurementId && !gtmId) {
      var gaScript = document.createElement('script');
      gaScript.async = true;
      gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaMeasurementId;
      document.head.appendChild(gaScript);
      function gtag(){ window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaMeasurementId, { send_page_view: true });
    }

    // 6. LinkedIn Insight Tag
    if (linkedinPartnerId) {
      window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
      window._linkedin_data_partner_ids.push(linkedinPartnerId);
      (function(l) {
        if (!l){window.lintrk = function(a,b){window.lintrk.q.push([a,b])};
        window.lintrk.q=[]}
        var s = document.getElementsByTagName("script")[0];
        var b = document.createElement("script");
        b.type = "text/javascript";b.async = true;
        b.src = "https://snap.licdn.com/tag.js";
        s.parentNode.insertBefore(b, s);
      })(window.lintrk);
    }

    // 7. Unified Multi-Platform Analytics Dispatcher
    window.goShippingTrack = function(eventName, data) {
      data = data || {};
      data.domain = window.location.hostname;
      data.path = window.location.pathname;
      data.timestamp = new Date().toISOString();

      // Dispatch to GTM / DataLayer
      if (window.dataLayer) {
        window.dataLayer.push({
          event: eventName,
          ...data
        });
      }

      // Dispatch to Meta Pixel
      if (window.fbq) {
        var metaEventMap = {
          'Lead': 'Lead',
          'quote_requested': 'Lead',
          'Contact': 'Contact',
          'whatsapp_click': 'Contact',
          'phone_click': 'Contact',
          'Search': 'Search',
          'shipment_tracked': 'Search',
          'CompleteRegistration': 'CompleteRegistration',
          'user_registered': 'CompleteRegistration',
          'ViewContent': 'ViewContent',
          'InitiateCheckout': 'InitiateCheckout'
        };
        var standardMeta = metaEventMap[eventName];
        if (standardMeta) {
          window.fbq('track', standardMeta, data);
        } else {
          window.fbq('trackCustom', eventName, data);
        }
      }

      // Dispatch to TikTok Pixel
      if (window.ttq) {
        var ttEventMap = {
          'Lead': 'SubmitForm',
          'quote_requested': 'SubmitForm',
          'Contact': 'Contact',
          'whatsapp_click': 'Contact',
          'Search': 'Search',
          'CompleteRegistration': 'CompleteRegistration',
          'InitiateCheckout': 'InitiateCheckout'
        };
        var standardTT = ttEventMap[eventName] || eventName;
        window.ttq.track(standardTT, data);
      }

      // Dispatch to LinkedIn
      if (window.lintrk && (eventName === 'Lead' || eventName === 'quote_requested' || eventName === 'Contact')) {
        window.lintrk('track', { conversion_id: data.linkedin_conversion_id || 0 });
      }

      // Dispatch Custom DOM Event for any third-party listeners
      window.dispatchEvent(new CustomEvent('goshipping:track', {
        detail: { event: eventName, data: data }
      }));
    };

    // 8. Automatic Interaction Tracking (WhatsApp, Calls, Emails, Quote CTA)
    document.addEventListener('click', function(e) {
      var el = e.target.closest('a, button');
      if (!el) return;

      var href = el.getAttribute('href') || '';
      var text = (el.textContent || '').trim().substring(0, 50);

      if (href.includes('wa.me') || href.includes('whatsapp')) {
        window.goShippingTrack('Contact', {
          channel: 'whatsapp',
          link: href,
          label: text
        });
      } else if (href.startsWith('tel:')) {
        window.goShippingTrack('Contact', {
          channel: 'phone',
          phone_number: href.replace('tel:', ''),
          label: text
        });
      } else if (href.startsWith('mailto:')) {
        window.goShippingTrack('Contact', {
          channel: 'email',
          email_address: href.replace('mailto:', ''),
          label: text
        });
      } else if (href.includes('#quote') || href.includes('quote-section')) {
        window.goShippingTrack('InitiateCheckout', {
          target: 'quote_form',
          label: text
        });
      }
    }, { passive: true });

  })();
</script>
