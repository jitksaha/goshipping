---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "GoShipping — Let's Move Your Business Forward",
  description = 'We provide reliable shipping wherever you need it. High-velocity air & ocean freight forwarding, licensed customs clearance, and live tracking telemetry.',
  currentPath = '/'
} = Astro.props;

const user = Astro.locals?.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Manrope & Inter & Noto Sans Bengali -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&family=Noto+Sans+Bengali:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#FAFAFA] text-[#11181E] flex flex-col min-h-screen selection:bg-[#EA1D2C] selection:text-white font-['Inter',sans-serif]">
    <!-- Minimalist Top Navigation -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <!-- Brand Logo / Wordmark in editorial slash format -->
        <a href="/" class="flex items-center gap-2 group" aria-label="GoShipping">
          <span class="text-xl font-extrabold tracking-tighter font-['Manrope',sans-serif] text-slate-900 group-hover:text-[#EA1D2C] transition-colors-fast">
            <span class="text-[#EA1D2C]">/</span>GOSHIPPING
          </span>
        </a>

        <!-- Center Menu Links -->
        <nav class="hidden md:flex items-center space-x-8 text-xs font-semibold text-slate-600">
          <a href="/about" class="hover:text-slate-900 transition-colors-fast">About us</a>
          <a href="/services" class="hover:text-slate-900 transition-colors-fast">Services</a>
          <a href="/services#approach" class="hover:text-slate-900 transition-colors-fast">Our Approach</a>
          <a href="/#technology" class="hover:text-slate-900 transition-colors-fast">Technology</a>
          <a href="/tracking" class="hover:text-[#EA1D2C] transition-colors-fast">Tracking</a>
        </nav>

        <!-- Right Action Buttons -->
        <div class="flex items-center gap-3">
          <a
            href="/contact"
            class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-[#11181E] text-white text-xs font-bold hover:bg-slate-800 transition-colors-fast"
          >
            Contact Us
          </a>

          {user ? (
            <a
              href={user.role === 'customer' ? '/dashboard' : '/admin'}
              class="inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-slate-300 bg-white text-slate-900 text-xs font-bold hover:border-slate-400 hover:bg-slate-50 transition-colors-fast"
            >
              Portal ({user.fullName.split(' ')[0]})
            </a>
          ) : (
            <a
              href="/login"
              class="inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-slate-300 bg-white text-slate-900 text-xs font-bold hover:border-slate-400 hover:bg-slate-50 transition-colors-fast"
            >
              Sign In
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Editorial Minimalist Footer -->
    <footer class="bg-[#11181E] text-slate-300 pt-20 pb-12 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
          <!-- Col 1: Brand & Tagline -->
          <div class="md:col-span-5 space-y-4">
            <span class="text-2xl font-extrabold tracking-tighter font-['Manrope',sans-serif] text-white">
              <span class="text-[#EA1D2C]">/</span>GOSHIPPING
            </span>
            <p class="text-xs text-slate-400 max-w-sm leading-relaxed">
              We specialize in providing reliable and efficient logistics solutions. High-velocity air & ocean freight forwarding, licensed customs clearance, and authenticated waypoint telemetry.
            </p>
            <div class="pt-2 text-[11px] text-slate-500 font-mono">
              BAFFA · IATA CARGO AGENT · FIATA · CHITTAGONG CUSTOMS #182
            </div>
          </div>

          <!-- Col 2: Services -->
          <div class="md:col-span-2 space-y-3">
            <h4 class="text-xs font-bold text-white uppercase tracking-wider">Services</h4>
            <ul class="text-xs space-y-2 text-slate-400">
              <li><a href="/services" class="hover:text-white transition-colors-fast">Ocean Freight</a></li>
              <li><a href="/services" class="hover:text-white transition-colors-fast">Air Cargo</a></li>
              <li><a href="/services" class="hover:text-white transition-colors-fast">Warehousing</a></li>
              <li><a href="/services" class="hover:text-white transition-colors-fast">Customs Clearance</a></li>
              <li><a href="/services" class="hover:text-white transition-colors-fast">Supply Chain</a></li>
            </ul>
          </div>

          <!-- Col 3: Company -->
          <div class="md:col-span-2 space-y-3">
            <h4 class="text-xs font-bold text-white uppercase tracking-wider">Company</h4>
            <ul class="text-xs space-y-2 text-slate-400">
              <li><a href="/about" class="hover:text-white transition-colors-fast">About Us</a></li>
              <li><a href="/#why-choose-us" class="hover:text-white transition-colors-fast">Why Choose Us</a></li>
              <li><a href="/contact" class="hover:text-white transition-colors-fast">Global Hubs</a></li>
              <li><a href="/tracking" class="hover:text-white transition-colors-fast">Live Tracking</a></li>
              <li><a href="/login" class="hover:text-white transition-colors-fast">Sign In</a></li>
            </ul>
          </div>

          <!-- Col 4: Regional Hubs -->
          <div class="md:col-span-3 space-y-3 text-xs text-slate-400">
            <h4 class="text-xs font-bold text-white uppercase tracking-wider">Operations Desk</h4>
            <p><strong class="text-slate-200">Dhaka HQ:</strong> Plot 14, Sector 3, Uttara Export Zone</p>
            <p><strong class="text-slate-200">Port CFS:</strong> Chittagong Maritime Point</p>
            <p><strong class="text-slate-200">Direct Hotline:</strong> +880 2 890 1200 / +880 9638-005544</p>
            <p><strong class="text-slate-200">Email:</strong> ops@goshipping.com</p>
          </div>
        </div>

        <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 gap-4">
          <p>© {new Date().getFullYear()} GoShipping Logistics Ltd. All rights reserved.</p>
          <div class="flex items-center space-x-6">
            <span>Astro + React + Kumo UI + Hono</span>
            <a href="/about" class="hover:text-slate-300">Privacy Notice</a>
            <a href="/about" class="hover:text-slate-300">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
