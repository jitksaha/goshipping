            `;
            const guestHtmlMobile = `
              <a
                href="/login"
                class="block text-center py-2.5 text-xs font-bold text-white bg-[#EA1D2C] hover:bg-[#D41523] rounded-md shadow-xs"
              >
                Sign In
              </a>
            `;
            if (desktopContainer) desktopContainer.innerHTML = guestHtmlDesktop;
            if (mobileContainer) mobileContainer.innerHTML = guestHtmlMobile;
          }
        } catch {
          // SSR initial render persists safely
        }
      })();
    </script>
