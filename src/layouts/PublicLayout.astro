                      <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    <span>Sign Out</span>
                  </a>
                </div>
              </div>
            `;

            const mobileHtml = `
              <div class="space-y-2">
                <a
                  href="${dashboardUrl}"
                  class="block text-center py-2.5 text-xs font-bold text-white bg-[#EA1D2C] hover:bg-[#D41523] rounded-md shadow-xs"
                >
                  Open Dashboard
                </a>
                <div class="grid grid-cols-2 gap-1.5 text-xs font-medium pt-1">
                  <a href="${dashboardUrl}?tab=overview" class="py-2 px-2.5 rounded bg-slate-50 border border-slate-200 text-slate-700 text-center">Overview</a>
                  <a href="${dashboardUrl}?tab=shipments" class="py-2 px-2.5 rounded bg-slate-50 border border-slate-200 text-slate-700 text-center">My Shipments</a>
                  <a href="${dashboardUrl}?tab=tracking" class="py-2 px-2.5 rounded bg-slate-50 border border-slate-200 text-slate-700 text-center">Live Tracking</a>
                  <a href="${dashboardUrl}?tab=quotes" class="py-2 px-2.5 rounded bg-slate-50 border border-slate-200 text-slate-700 text-center">My Quotes</a>
                  <a href="${dashboardUrl}?tab=request-quote" class="py-2 px-2.5 rounded bg-slate-50 border border-slate-200 text-slate-700 text-center">Get Quote</a>
                  <a href="${dashboardUrl}?tab=documents" class="py-2 px-2.5 rounded bg-slate-50 border border-slate-200 text-slate-700 text-center">Invoices</a>
