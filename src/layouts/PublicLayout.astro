    <script>
      const toggle = document.getElementById('mobile-nav-toggle');
      const menu = document.getElementById('mobile-nav-menu');
      if (toggle && menu) {
        toggle.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }

      function setupSplitButtonDropdown() {
        const toggleBtn = document.getElementById('header-user-split-toggle');
        const splitMenu = document.getElementById('header-user-split-menu');
        const chevron = document.getElementById('header-split-chevron');

        if (toggleBtn && splitMenu) {
          toggleBtn.onclick = (e) => {
            e.stopPropagation();
            const isHidden = splitMenu.classList.contains('hidden');
            if (isHidden) {
              splitMenu.classList.remove('hidden');
              toggleBtn.setAttribute('aria-expanded', 'true');
              if (chevron) chevron.classList.add('rotate-180');
            } else {
              splitMenu.classList.add('hidden');
              toggleBtn.setAttribute('aria-expanded', 'false');
              if (chevron) chevron.classList.remove('rotate-180');
            }
          };

          document.addEventListener('click', (e) => {
            if (!splitMenu.contains(e.target as Node) && !toggleBtn.contains(e.target as Node)) {
              splitMenu.classList.add('hidden');
              toggleBtn.setAttribute('aria-expanded', 'false');
              if (chevron) chevron.classList.remove('rotate-180');
            }
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              splitMenu.classList.add('hidden');
              toggleBtn.setAttribute('aria-expanded', 'false');
              if (chevron) chevron.classList.remove('rotate-180');
            }
          });
        }
      }

      // Initial setup for SSR rendered split button
      setupSplitButtonDropdown();

      // Dynamic Auth session sync with database & session cookie
      (async function syncAuthButton() {
        try {
          const res = await fetch('/api/auth/me', { headers: { 'Accept': 'application/json' } });
          if (!res.ok) return;
          const data = await res.json();
          const desktopContainer = document.getElementById('header-auth-container');
          const mobileContainer = document.getElementById('mobile-auth-container');

          if (data && data.authenticated && data.user) {
            const dashboardUrl = data.user.role === 'customer' ? '/dashboard' : '/admin';
            const fullName = data.user.fullName || 'User Portal';

            const desktopHtml = `
              <div class="relative inline-flex items-center" id="header-user-split-container">
                <div class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 shadow-2xs">
                  <a
                    id="header-auth-btn"
                    href="${dashboardUrl}"
                    class="h-9 inline-flex items-center gap-1.5 px-3.5 text-xs font-bold text-slate-800 hover:text-[#EA1D2C] hover:bg-slate-100 rounded-l-md transition-none"
