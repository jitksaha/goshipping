                    <span>Live Tracking</span>
                  </a>

                  <a href="${dashboardUrl}?tab=quotes" class="flex items-center gap-2 px-3 py-2 text-slate-700 hover:bg-slate-50 hover:text-[#EA1D2C] transition-none">
                    <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
