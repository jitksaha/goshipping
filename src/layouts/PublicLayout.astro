---
import '../styles/global.css';
import { getSiteOrigin, getCanonicalUrl, getAssetUrl } from '../server/utils/domain';
import { getTrackingConfig } from '../server/utils/tracking';
import TrackingHead from '../components/analytics/TrackingHead.astro';
import TrackingBody from '../components/analytics/TrackingBody.astro';
import WhatsAppLiveChatWidget from '../components/marketing/WhatsAppLiveChatWidget';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  currentPath?: string;
  image?: string;
}

const {
  title = "Go Shipping | China to Bangladesh Shipping & Logistics",
  description = "Reliable China to Bangladesh air and sea shipment services with door-to-door delivery, secure cargo handling and logistics support.",
  keywords = "China to Bangladesh shipping, China to Bangladesh logistics, China to Bangladesh air shipment, China to Bangladesh sea shipment, door-to-door delivery Bangladesh, China cargo forwarding, Guangzhou to Dhaka freight, Shenzhen to Chittagong shipping, customs clearance Bangladesh, DDP shipping Bangladesh, China warehouse support, e-commerce shipping Bangladesh, Go Shipping, goshipping.com.bd",
  currentPath = '/',
  image = '/og/og-default.png'
} = Astro.props;

// Dynamic Domain Resolution (Request Headers -> Environment Variables -> Production Default)
const siteOrigin = getSiteOrigin(Astro.request);
const canonicalUrl = getCanonicalUrl(currentPath, Astro.request);
const ogImageUrl = getAssetUrl(image, Astro.request);
const trackingConfig = getTrackingConfig();
const user = Astro.locals?.user;
---

<!doctype html>
<html lang="en" class="overflow-x-clip scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="alternate icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Go Shipping" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#EA1D2C" />

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn Preview (1200x630 High Res) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Go Shipping" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="bn_BD" />

    <!-- Twitter / X Summary Large Image -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Geographical / Regional Meta -->
    <meta name="geo.region" content="BD" />
    <meta name="geo.placename" content="Dhaka, Bangladesh" />
    <meta name="target" content="all" />

    <!-- Google Fonts: Manrope (Headings/Editorial), Inter (UI/Body) & Noto Sans Bengali -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&family=Noto+Sans+Bengali:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Multi-Platform Tracking & DataLayer (GTM, Meta Pixel, TikTok, GA4, LinkedIn) -->
    <TrackingHead config={trackingConfig} siteOrigin={siteOrigin} />

    <!-- Structured Data: Organization & LogisticsService (JSON-LD with Dynamic Domain) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "LogisticsService",
          "@id": `${siteOrigin}/#organization`,
          "name": "Go Shipping",
          "alternateName": ["GoShipping", "Go Shipping Bangladesh"],
          "url": siteOrigin,
          "logo": `${siteOrigin}/brand/logo-light.svg`,
          "image": `${siteOrigin}/brand/logo-light.svg`,
          "description": "Reliable China to Bangladesh air and sea shipment services with door-to-door delivery, secure cargo handling and logistics support.",
          "telephone": "+8801797252627",
          "email": "hello@goshipping.com.bd",
          "priceRange": "$$",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Dhaka",
            "addressCountry": "BD"
          },
          "areaServed": [
            { "@type": "Country", "name": "Bangladesh" },
            { "@type": "Country", "name": "China" }
          ],
          "sameAs": [
            "https://wa.me/8801797252627"
          ],
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "China to Bangladesh Shipping Services",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "China to Bangladesh Air Shipment",
                  "description": "Fast air cargo service with 3-5 days delivery from Guangzhou/Shenzhen to Dhaka."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "China to Bangladesh Sea Shipment",
                  "description": "Cost-effective FCL and LCL container maritime shipping from Guangzhou and Shenzhen to Chittagong Port."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Door-to-Door Delivery Bangladesh",
                  "description": "All-inclusive DDP freight forwarding with customs clearance and doorstep delivery across Bangladesh."
                }
              },
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "China Warehouse Support",
                  "description": "Consolidation warehouses in Guangzhou, Yiwu, and Shenzhen for online sellers and commercial importers."
                }
              }
            ]
          }
        },
        {
          "@type": "WebSite",
          "@id": `${siteOrigin}/#website`,
          "url": siteOrigin,
          "name": "Go Shipping",
          "publisher": {
            "@id": `${siteOrigin}/#organization`
          },
          "potentialAction": {
            "@type": "SearchAction",
            "target": `${siteOrigin}/tracking?code={search_term_string}`,
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} />
    
    <!-- Page-Specific Head & Schema Injection Slot -->
    <slot name="head" />
  </head>
  <body class="bg-[#FFFFFF] text-[#11181E] flex flex-col min-h-screen selection:bg-[#EA1D2C] selection:text-white font-['Inter',sans-serif] overflow-x-clip">
    <!-- Tracking Fallback Noscript Elements -->
    <TrackingBody config={trackingConfig} />
    <!-- Minimalist Industrial Top Navigation -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Original GoShipping Logo -->
        <a href="/" class="flex items-center gap-2 group shrink-0" aria-label="GoShipping Home">
          <img
            src="/brand/logo-light.svg"
            alt="Go Shipping"
            class="h-9 sm:h-10 w-auto object-contain"
          />
        </a>

        <!-- Center Menu Links (Aligned to 14px font standard with comfortable gap) -->
        <nav class="hidden md:flex items-center space-x-5 lg:space-x-6 text-sm font-semibold text-slate-700 font-['Manrope',sans-serif]">
          <a href="/services" class={`hover:text-[#EA1D2C] transition-colors duration-150 ${currentPath.startsWith('/services') ? 'text-[#EA1D2C]' : ''}`}>Services</a>
          <a href="/how-it-works" class={`hover:text-[#EA1D2C] transition-colors duration-150 ${currentPath === '/how-it-works' ? 'text-[#EA1D2C]' : ''}`}>How It Works</a>
          <a href="/quote" class={`hover:text-[#EA1D2C] transition-colors duration-150 ${currentPath === '/quote' ? 'text-[#EA1D2C]' : ''}`}>Ship for Me</a>
          <a href="/about" class={`hover:text-[#EA1D2C] transition-colors duration-150 ${currentPath === '/about' ? 'text-[#EA1D2C]' : ''}`}>About Us</a>
          <a href="/faq" class={`hover:text-[#EA1D2C] transition-colors duration-150 ${currentPath === '/faq' ? 'text-[#EA1D2C]' : ''}`}>FAQ</a>
          <a href="/contact" class={`hover:text-[#EA1D2C] transition-colors duration-150 ${currentPath === '/contact' ? 'text-[#EA1D2C]' : ''}`}>Contact</a>
        </nav>

        <!-- Right Action Buttons -->
        <div class="hidden sm:flex items-center space-x-2.5 sm:space-x-3">
          <!-- WhatsApp Quick Access (Real Official Meta Icon, Height equal to buttons h-9, No Background) -->
          <a
            href="https://wa.me/8801797252627?text=Hello%20Go%20Shipping%2C%20I%20would%20like%20a%20shipping%20quote."
            target="_blank"
            rel="noreferrer"
            class="h-9 w-9 inline-flex items-center justify-center shrink-0 hover:scale-105 active:scale-95 transition-transform"
            aria-label="WhatsApp Support (+880 1797-252627)"
            title="Chat on WhatsApp (+880 1797-252627)"
          >
            <svg class="w-9 h-9" viewBox="0 0 48 48" fill="none">
              <path fill="#25D366" fill-rule="evenodd" clip-rule="evenodd" d="M24 4C12.954 4 4 12.954 4 24c0 3.513.91 6.815 2.502 9.682L4 44l10.59-2.433A19.92 19.92 0 0 0 24 44c11.046 0 20-8.954 20-20S35.046 4 24 4z"/>
              <path fill="#FFFFFF" d="M33.6 28.8c-.46-.23-2.73-1.35-3.15-1.5-.42-.16-.73-.23-1.04.23-.31.47-1.19 1.5-1.45 1.8-.27.31-.53.35-1 .12-.46-.23-1.96-.72-3.73-2.3-1.38-1.23-2.31-2.75-2.58-3.21-.27-.46-.03-.71.2-.94.21-.21.46-.54.7-.81.23-.27.31-.46.46-.77.15-.31.08-.58-.04-.81-.12-.23-1.04-2.5-1.42-3.42-.38-.9-.76-.78-1.04-.79h-.88c-.31 0-.81.12-1.23.58-.42.46-1.61 1.58-1.61 3.85 0 2.27 1.65 4.46 1.88 4.77.23.31 3.25 4.96 7.87 6.96 1.1.48 1.96.76 2.63.98 1.1.35 2.11.3 2.91.18.89-.13 2.73-1.12 3.12-2.19.38-1.08.38-2 .27-2.19-.12-.19-.42-.31-.88-.54z"/>
            </svg>
          </a>

          <!-- Track Shipment Button (Direct access next to auth button, exact h-9) -->
          <a
            href="/tracking"
            class={`h-9 inline-flex items-center gap-1.5 px-3.5 text-xs font-bold rounded-md border transition-colors duration-150 ${currentPath.startsWith('/tracking') ? 'text-[#EA1D2C] bg-red-50 border-red-200' : 'text-slate-800 bg-slate-50 hover:bg-slate-100 hover:text-[#EA1D2C] border-slate-200'}`}
            title="Track Shipment"
          >
            <svg class="w-3.5 h-3.5 text-[#EA1D2C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Track</span>
          </a>

          <!-- Dynamic Auth Controls (Single Sign In button if guest; Split Dashboard Button if authenticated) -->
          <div id="header-auth-container" class="inline-flex items-center">
            {user ? (
              <div class="relative inline-flex items-center" id="header-user-split-container">
                <div class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 shadow-2xs">
                  <a
                    id="header-auth-btn"
                    href={user.role === 'customer' ? '/dashboard' : '/admin'}
                    class="h-9 inline-flex items-center gap-1.5 px-3.5 text-xs font-bold text-slate-800 hover:text-[#EA1D2C] hover:bg-slate-100 rounded-l-md transition-none"
                    title="Open Dashboard"
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span>Dashboard</span>
                  </a>
                  <div class="w-[1px] h-4 bg-slate-200"></div>
                  <button
                    type="button"
                    id="header-user-split-toggle"
                    aria-expanded="false"
                    aria-haspopup="true"
                    class="h-9 px-2 inline-flex items-center justify-center text-slate-500 hover:text-slate-900 hover:bg-slate-100 rounded-r-md transition-none cursor-pointer"
                    title="Dashboard Quick Links"
                  >
                    <svg class="w-3.5 h-3.5 stroke-[2] transition-transform duration-150" id="header-split-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </button>
                </div>

                <!-- Dropdown Menu -->
                <div
                  id="header-user-split-menu"
                  class="hidden absolute right-0 top-full mt-1.5 w-56 bg-white rounded-lg border border-slate-200 shadow-lg py-1.5 z-50 text-xs font-medium font-['Inter',sans-serif]"
                >
                  <div class="px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider text-slate-400 border-b border-slate-100 flex items-center justify-between">
                    <span class="truncate">{user.fullName || 'User Portal'}</span>
                    <span class="text-emerald-600 font-bold font-sans">Active</span>
                  </div>

                  <a href={user.role === 'customer' ? '/dashboard?tab=overview' : '/admin?tab=overview'} class="flex items-center gap-2 px-3 py-2 text-slate-700 hover:bg-slate-50 hover:text-[#EA1D2C] transition-none">
                    <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="7" height="7" rx="1"/>
                      <rect x="14" y="3" width="7" height="7" rx="1"/>
                      <rect x="14" y="14" width="7" height="7" rx="1"/>
                      <rect x="3" y="14" width="7" height="7" rx="1"/>
                    </svg>
                    <span>Overview</span>
                  </a>

                  <a href={user.role === 'customer' ? '/dashboard?tab=shipments' : '/admin?tab=shipments'} class="flex items-center gap-2 px-3 py-2 text-slate-700 hover:bg-slate-50 hover:text-[#EA1D2C] transition-none">
                    <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="1" y="6" width="16" height="13" rx="2"/>
                      <circle cx="5.5" cy="18.5" r="2.5"/>
                      <circle cx="18.5" cy="18.5" r="2.5"/>
                      <path d="M17 10h4l3 3v3h-3"/>
                    </svg>
                    <span>My Shipments</span>
                  </a>

                  <a href={user.role === 'customer' ? '/dashboard?tab=tracking' : '/admin?tab=tracking'} class="flex items-center gap-2 px-3 py-2 text-slate-700 hover:bg-slate-50 hover:text-[#EA1D2C] transition-none">
                    <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                    </svg>
                    <span>Live Tracking</span>
                  </a>

                  <a href={user.role === 'customer' ? '/dashboard?tab=quotes' : '/admin?tab=quotes'} class="flex items-center gap-2 px-3 py-2 text-slate-700 hover:bg-slate-50 hover:text-[#EA1D2C] transition-none">
                    <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                      <line x1="16" y1="13" x2="8" y2="13"/>
                      <line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                    <span>My Quotes</span>
                  </a>

                  <a href={user.role === 'customer' ? '/dashboard?tab=request-quote' : '/quote'} class="flex items-center gap-2 px-3 py-2 text-slate-700 hover:bg-slate-50 hover:text-[#EA1D2C] transition-none">
                    <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"/>
                      <line x1="12" y1="8" x2="12" y2="16"/>
                      <line x1="8" y1="12" x2="16" y2="12"/>
                    </svg>
                    <span>Get Quote ("Ship for Me")</span>
                  </a>

                  <a href={user.role === 'customer' ? '/dashboard?tab=documents' : '/admin?tab=invoices'} class="flex items-center gap-2 px-3 py-2 text-slate-700 hover:bg-slate-50 hover:text-[#EA1D2C] transition-none">
                    <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="5" width="20" height="14" rx="2"/>
                      <line x1="2" y1="10" x2="22" y2="10"/>
                    </svg>
                    <span>Invoices &amp; Billing</span>
                  </a>

                  <a href={user.role === 'customer' ? '/dashboard?tab=settings' : '/admin?tab=users'} class="flex items-center gap-2 px-3 py-2 text-slate-700 hover:bg-slate-50 hover:text-[#EA1D2C] transition-none">
                    <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="3"/>
                      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                    <span>Profile &amp; Settings</span>
                  </a>

                  <div class="border-t border-slate-100 my-1"></div>

                  <a href="/logout" class="flex items-center gap-2 px-3 py-2 text-red-600 hover:bg-red-50 transition-none font-semibold">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                      <polyline points="16 17 21 12 16 7"/>
                      <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    <span>Sign Out</span>
                  </a>
                </div>
              </div>
            ) : (
              <a
                id="header-auth-btn"
                href="/login"
                class="h-9 inline-flex items-center px-4 text-xs font-bold text-white bg-[#EA1D2C] hover:bg-[#D41523] rounded-md transition-none shadow-xs"
              >
                Sign In
              </a>
            )}
          </div>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-nav-toggle"
          class="md:hidden p-2 text-slate-700 hover:text-black focus:outline-none"
          aria-label="Toggle Navigation"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div id="mobile-nav-menu" class="hidden md:hidden border-t border-slate-100 bg-white px-4 pt-3 pb-6 space-y-3 font-['Manrope']">
        <a href="/services" class="block py-2 text-sm font-semibold text-slate-800">All Services</a>
        <a href="/services/air-shipment" class="block py-1.5 pl-3 text-xs text-slate-600">↳ Air Shipment (3-7 Days)</a>
        <a href="/services/sea-shipment" class="block py-1.5 pl-3 text-xs text-slate-600">↳ Sea Shipment (FCL/LCL)</a>
        <a href="/services/door-to-door" class="block py-1.5 pl-3 text-xs text-slate-600">↳ Door-to-Door Delivery</a>
        <a href="/services/customs-clearance" class="block py-1.5 pl-3 text-xs text-slate-600">↳ Customs Clearance Support</a>
        <a href="/services/china-warehouse" class="block py-1.5 pl-3 text-xs text-slate-600">↳ China Warehouse Support</a>
        <a href="/how-it-works" class="block py-2 text-sm font-semibold text-slate-800">How It Works</a>
        <a href="/quote" class="block py-2 text-sm font-semibold text-[#EA1D2C]">Ship for Me</a>
        <a href="/about" class="block py-2 text-sm font-semibold text-slate-800">About Us</a>
        <a href="/faq" class="block py-2 text-sm font-semibold text-slate-800">FAQ</a>
        <a href="/contact" class="block py-2 text-sm font-semibold text-slate-800">Contact</a>
        <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
          <div class="grid grid-cols-2 gap-2">
            <a
              href="https://wa.me/8801797252627?text=Hello%20Go%20Shipping%2C%20I%20would%20like%20a%20shipping%20quote."
              target="_blank"
              rel="noreferrer"
              class="flex items-center justify-center gap-1.5 py-2.5 text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-md transition-colors duration-150"
            >
              <svg class="w-4 h-4 fill-emerald-600" viewBox="0 0 24 24">
