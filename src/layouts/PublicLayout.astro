            `;

            if (desktopContainer) desktopContainer.innerHTML = desktopHtml;
            if (mobileContainer) mobileContainer.innerHTML = mobileHtml;
            setupSplitButtonDropdown();
          } else {
            const guestHtmlDesktop = `
              <a
                id="header-auth-btn"
                href="/login"
                class="h-9 inline-flex items-center px-4 text-xs font-bold text-white bg-[#EA1D2C] hover:bg-[#D41523] rounded-md transition-none shadow-xs"
              >
                Sign In
