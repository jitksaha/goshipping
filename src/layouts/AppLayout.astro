---
import '../styles/global.css';
import type { AuthUser } from '../server/auth/session';

interface Props {
  title?: string;
  portalType?: 'customer' | 'admin';
  activeTab?: string;
}

const {
  title = 'GoShipping Workspace',
  portalType = 'customer',
  activeTab = 'overview'
} = Astro.props;

const user = Astro.locals.user as AuthUser;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <title>{title} | GoShipping</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#F8FAFC] text-[#11181E] flex h-screen overflow-hidden font-['Inter',sans-serif]">
    <!-- Left Navigation Sidebar -->
    <aside class="w-64 bg-[#11181E] text-slate-300 flex flex-col flex-shrink-0 border-r border-slate-800">
      <!-- App Brand Header -->
      <div class="h-16 flex items-center justify-between px-5 border-b border-slate-800">
        <a href="/" class="flex items-center gap-2">
          <img src="/brand/logo-dark.svg" alt="GoShipping" class="h-7 w-auto" />
        </a>
        <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded ${
          portalType === 'admin' ? 'bg-[#EA1D2C] text-white' : 'bg-slate-800 text-slate-300'
        }`}>
          {portalType === 'admin' ? 'Ops Control' : 'Client Hub'}
        </span>
      </div>

      <!-- Navigation Links -->
      <div class="flex-1 overflow-y-auto py-4 px-3 space-y-1 text-xs">
        {portalType === 'customer' ? (
          <>
            <div class="px-3 pb-2 text-[10px] font-bold uppercase tracking-wider text-slate-400">Shipment & Orders</div>
            <a
              href="/dashboard?tab=overview"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'overview' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>Overview</span>
            </a>
            <a
              href="/dashboard?tab=shipments"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'shipments' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>My Shipments</span>
            </a>
            <a
              href="/dashboard?tab=tracking"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'tracking' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>Live Tracking</span>
            </a>

            <div class="pt-4 px-3 pb-2 text-[10px] font-bold uppercase tracking-wider text-slate-400">Quotations & Pricing</div>
            <a
              href="/dashboard?tab=request-quote"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'request-quote' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>Request Quote</span>
            </a>
            <a
              href="/dashboard?tab=quotes"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'quotes' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>My Quotations</span>
            </a>

            <div class="pt-4 px-3 pb-2 text-[10px] font-bold uppercase tracking-wider text-slate-400">Account & Docs</div>
            <a
              href="/dashboard?tab=documents"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'documents' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>Documents & Invoices</span>
            </a>
            <a
              href="/dashboard?tab=settings"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'settings' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>Profile & Settings</span>
            </a>
          </>
        ) : (
          <>
            <div class="px-3 pb-2 text-[10px] font-bold uppercase tracking-wider text-slate-400">Operations Control</div>
            <a
              href="/admin?tab=overview"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'overview' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>Overview & KPIs</span>
            </a>
            <a
              href="/admin?tab=shipments"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'shipments' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>Shipment Management</span>
            </a>
            <a
              href="/admin?tab=events"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'events' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>Log Tracking Event</span>
            </a>
            <a
              href="/admin?tab=quotes"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'quotes' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>Quote Management</span>
            </a>
            <a
              href="/admin?tab=warehouses"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'warehouses' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>Warehouse Operations</span>
            </a>

            <div class="pt-4 px-3 pb-2 text-[10px] font-bold uppercase tracking-wider text-slate-400">Governance & System</div>
            <a
              href="/admin?tab=audit"
              class={`flex items-center gap-3 px-3 py-2 rounded-md font-medium transition-colors-fast ${
                activeTab === 'audit' ? 'bg-[#EA1D2C] text-white' : 'hover:bg-slate-800/60 hover:text-white'
              }`}
            >
              <span>Audit Logs & Security</span>
            </a>
            <a
              href="/dashboard"
              class="flex items-center gap-3 px-3 py-2 rounded-md font-medium text-slate-400 hover:bg-slate-800/60 hover:text-white"
            >
              <span>Switch to Customer View</span>
            </a>
          </>
        )}
      </div>

      <!-- User Info & Logout Footer -->
      <div class="p-4 border-t border-slate-800 bg-[#0B1015]">
        <div class="flex items-center justify-between mb-3">
          <div class="truncate">
            <p class="text-xs font-semibold text-white truncate">{user?.fullName || 'Authorized User'}</p>
            <p class="text-[10px] text-slate-400 font-mono capitalize">{user?.role?.replace('_', ' ') || 'Guest'}</p>
          </div>
          <span class="w-2.5 h-2.5 rounded-full bg-[#10B981] flex-shrink-0" title="Connected"></span>
        </div>
        <button
          onclick="fetch('/api/auth/logout', { method: 'POST' }).then(() => window.location.href = '/')"
          class="w-full text-left text-xs font-medium text-slate-400 hover:text-white transition-colors-fast py-1"
        >
          ← Sign Out
        </button>
      </div>
    </aside>

    <!-- Main Workspace -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <!-- Top Bar -->
      <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between flex-shrink-0">
        <div class="flex items-center gap-3">
          <h1 class="text-base font-bold text-slate-900 tracking-tight">{title}</h1>
          <span class="hidden md:inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
            Node.js SSR · MySQL Active
          </span>
        </div>

        <div class="flex items-center gap-4">
          <a
            href="/"
            class="text-xs font-medium text-slate-500 hover:text-[#EA1D2C] transition-colors-fast"
            target="_blank"
          >
            Public Site ↗
          </a>
          <div class="h-4 w-px bg-slate-200"></div>
          <div class="text-xs text-slate-500 font-medium">
            Role: <span class="text-slate-900 font-semibold uppercase">{user?.role?.replace('_', ' ') || 'User'}</span>
          </div>
        </div>
      </header>

      <!-- Scrollable Application Body -->
      <main class="flex-1 overflow-y-auto p-6 md:p-8 bg-[#F8FAFC]">
        <slot />
      </main>
    </div>
  </body>
</html>
