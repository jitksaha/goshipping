# =========================================================================
# GoShipping — Git Ignore Configuration
# =========================================================================

# Production Builds & Bundler Caches
dist/
.astro/
.output/
.cache/
.vite/
*.zip
*.tar.gz

# Dependencies
node_modules/
package-lock.json.bak

# Secrets & Environment Configurations (CRITICAL: Never commit to Git)
.env
.env.local
.env.*.local
.env.production
.env.staging
!.env.example

# Authentication, Session Stores & Security Caches
.auth_store.json
.sessions.json
.deploy-pause

# Logs & Debug Traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Scratch & Temporary Testing Scripts
scratch/
scripts/test_*.mjs
scripts/temp_*.js
graphify-out/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE, Editor & Tooling Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
